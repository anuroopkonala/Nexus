## parser_utils.nxasm
## Globals: r100 = token index (float), r50 = token array ptr

LABEL 500
## Get current token type -> r130
LOAD 32.0 120
MUL 121 100 120
LOAD_F 130 50 121
RET

LABEL 501
## Advance token
LOAD 1.0 120
ADD 100 100 120
RET

LABEL 502
## Match token type in r110. If matches, advance and return 1.0 in r130, else 0.0.
CALL 500
EQ 120 130 110
JMP_F 120 503
CALL 501
LOAD 1.0 130
RET
LABEL 503
LOAD 0.0 130
RET


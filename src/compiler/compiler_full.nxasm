LOAD 8.0 120
EQ 121 130 120
JMP_F 121 618
CALL 501
PUSH 140
CALL 600
POP 140
## After parsing inner expr, expect ')' (9.0)
CALL 501
JMP 630

LABEL 618
## Unary minus: token 3.0
LOAD 3.0 120
EQ 121 130 120
JMP_F 121 621
CALL 501        # consume '-'
CALL 601        # parse primary
## Wrap in UNARY_NEG_EXPR (type 207.0)
LOAD 16.0 124
ALLOC 200 124   # temp in r200
LOAD 207.0 125
LOAD 0.0 126
STORE_F 200 126 125
LOAD 8.0 126
STORE_PTR_O 200 126 131  # operand
PUSH_PTR 200
POP_PTR 131              # result
JMP 630                  # into infix loop

LABEL 621
## Unary NOT: token 47.0
LOAD 47.0 120
EQ 121 130 120
JMP_F 121 619
CALL 501        # consume '!' / 'not'
CALL 601        # parse primary
## Wrap in UNARY_NOT_EXPR (type 212.0)
LOAD 16.0 124
ALLOC 200 124   # temp in r200
LOAD 212.0 125
LOAD 0.0 126
STORE_F 200 126 125
LOAD 8.0 126
STORE_PTR_O 200 126 131  # operand
PUSH_PTR 200
POP_PTR 131              # result

LABEL 630
## Infix loop. Check next operator
CALL 500

## Call 650 to get precedence -> r141
CALL 650

## If r141 == 0.0, break
LOAD 0.0 120
EQ 121 141 120
JMP_F 121 631
JMP 640
LABEL 631

## If r141 < r140, break
LT 121 141 140
JMP_F 121 632
JMP 640
LABEL 632


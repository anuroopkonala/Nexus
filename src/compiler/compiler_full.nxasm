LOAD 10.0 120
EQ 121 130 120
JMP_F 121 615
CALL 501       # consume ','
JMP 614
LABEL 615
CALL 501       # consume ']'
PUSH_PTR 215
POP_PTR 131
JMP 630

LABEL 620
## Dictionary literal: token 6.0
LOAD 6.0 120
EQ 121 130 120

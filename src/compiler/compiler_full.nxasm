## ================================================================
## NEXUS SELF-HOSTED LEXER v2.0
## Pure .nxasm ??? No C, No other languages
## Register Map:
##   0  = FILE* of source (pointer bank)
##   1  = current char (float, ASCII code)
##   2  = EOF = -1.0
##   3  = SPACE = 32.0
##   4  = NEWLINE = 10.0
##   5  = TAB = 9.0
##   6  = token buffer (pointer bank, 256 bytes malloc)
##   7  = token length counter (float)
##   8  = temp bool result
##   9  = temp char for lookahead
##  10  = const 1.0
##  11  = const 0.0
##  50  = filename ptr (pointer bank)
##  92  = 256.0 (for ALLOC size)
## ================================================================

LOAD_STR test_dict.nx 50
FOPEN 0 50
LOAD -1.0 2
LOAD 32.0 3
LOAD 10.0 4
LOAD 9.0 5
LOAD 1.0 10
LOAD 0.0 11
LOAD -1.0 13
LOAD 256.0 92

LOAD 1048576.0 92
LOAD 1048576.0 93
ALLOC 50 93   # token array in reg 50
LOAD 0.0 60   # token_offset in reg 60
LOAD 8.0 100  # +8
LOAD 32.0 101 # +32
LOAD 1.0 102  # +1 counter
LOAD 0.0 65   # token count
ALLOC 6 92    # string buffer in reg 6


## ================================================================
## ## ================================================================
LABEL 100
## ================================================================

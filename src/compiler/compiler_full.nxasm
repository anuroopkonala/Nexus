LOAD 1.0 120
ADD 140 141 120

CALL 601      # Parse RHS -> r131

POP_PTR 205   # LHS -> 205
POP 140       # restore min_precedence
POP 141       # restore current precedence
POP 130       # restore op_type
PUSH_PTR 131  # push RHS
POP_PTR 206   # pop RHS into 206


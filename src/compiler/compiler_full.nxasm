LOAD 0.0 63
LOAD 0.0 99
LOAD 0.0 97
LOAD 0.0 96
LOAD 0.0 95
## Array pointer table: r68=table ptr, r69=next slot
ALLOC 68 120
LOAD 0.0 69
## Main Parser Loop
LOAD 0.0 100

LABEL 801
  CALL 500
  LOAD 20.0 121
  EQ 122 130 121
  JMP_F 122 805
  JMP 802
LABEL 805
  CALL 700
  PUSH_PTR 131
  POP_PTR 200
  CALL 5100
  
  LOAD 1.0 120
  EQ 121 99 120
  JMP_F 121 801
  JMP 802

LABEL 802

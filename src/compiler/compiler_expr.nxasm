LOAD 8.0 121
ADD 71 71 121
RET

LABEL 5220
## IDENT_EXPR (204.0)
LOAD 204.0 120
EQ 121 201 120
JMP_F 121 5230

# Load Ident ptr (offset 8)
LOAD 8.0 120
LOAD_PTR_O 204 200 120
PUSH_PTR 204

# GET_OP LOAD_RAW
GET_OP LOAD_RAW 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

# The string ptr (from stack)
POP_PTR 204
STORE_PTR_O 70 71 204
LOAD 8.0 121
ADD 71 71 121

# Dest reg 30
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# GET_OP DICT_GET
GET_OP DICT_GET 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Dest reg 0
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Dict reg 250
LOAD 250.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Key ptr reg 30
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# PUSH 0
GET_OP PUSH 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

RET

LABEL 5230
## MEMBER_EXPR (211.0)
LOAD 211.0 120
EQ 121 201 120
JMP_F 121 5240

# Compile LHS (Object) -> pushes it onto the val_stack
PUSH_PTR 200
LOAD 8.0 120
LOAD_PTR_O 200 200 120
CALL 5200

# Get RHS (String pointer directly -> offset 16)
POP_PTR 200
LOAD 16.0 120
LOAD_PTR_O 204 200 120

# GET_OP LOAD_RAW: stores the raw string ptr into a ptr-reg at runtime
GET_OP LOAD_RAW 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Operand: string ptr (placed in ptr_bank reg 30 at runtime)
STORE_PTR_O 70 71 204
LOAD 8.0 121
ADD 71 71 121

# Dest reg = 30 (ptr_bank index holding key string)
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# POP object into dict_reg (251)
GET_OP POP 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 251.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# GET_OP DICT_GET
GET_OP DICT_GET 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Dest reg 0
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Dict reg 251
LOAD 251.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Key ptr reg 30
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# PUSH 0
GET_OP PUSH 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

RET

LABEL 5240
## DICT_EXPR (210.0)
LOAD 210.0 120
EQ 121 201 120
JMP_F 121 5250

# Emit DICT_NEW 251
GET_OP DICT_NEW 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 251.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Read pair count (offset 8)
LOAD 8.0 120
LOAD_F 202 200 120
PUSH 202
PRINT 202
POP 202
LOAD 0.0 203       # loop index

LABEL 5241
LT 120 203 202
JMP_F 120 5249

# Compile Key
LOAD 16.0 120
MUL 120 203 120
LOAD 16.0 122
ADD 122 122 120
PUSH_PTR 200
LOAD_PTR_O 200 200 122
PUSH 202
PUSH 203
CALL 5200
POP 203
POP 202
POP_PTR 200

# Compile Value
LOAD 16.0 120
MUL 120 203 120
LOAD 24.0 122
ADD 122 122 120
PUSH_PTR 200
LOAD_PTR_O 200 200 122
PUSH 202
PUSH 203
CALL 5200
POP 203
POP 202
POP_PTR 200

# POP Value into r2
GET_OP POP 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 2.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# POP Key into r30
GET_OP POP 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Emit DICT_SET 251 30 2
GET_OP DICT_SET 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 251.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 2.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Next pair
LOAD 1.0 120
ADD 203 203 120
JMP 5241

LABEL 5249
# PUSH dict (reg 251)
GET_OP PUSH 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 251.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

RET

LABEL 5250
## STRING_EXPR (206.0)
LOAD 206.0 120
EQ 121 201 120
JMP_F 121 5260

# Extract string pointer from STRING_EXPR (offset 8)
LOAD 8.0 120
LOAD_PTR_O 204 200 120

# GET_OP LOAD_RAW
GET_OP LOAD_RAW 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Store string pointer
STORE_PTR_O 70 71 204
LOAD 8.0 121
ADD 71 71 121

# Dest reg 2
LOAD 2.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# PUSH 2
GET_OP PUSH 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 2.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

RET

LABEL 5260
RET

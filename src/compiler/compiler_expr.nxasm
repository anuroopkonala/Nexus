STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Dest reg 0
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Dict reg 251
LOAD 251.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Key ptr reg 30
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# PUSH 0
GET_OP PUSH 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

RET


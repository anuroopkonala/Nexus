LABEL 5230
## MEMBER_EXPR (211.0)
LOAD 211.0 120
EQ 121 201 120
JMP_F 121 5240

# Compile LHS (Object) -> pushes it onto the val_stack
PUSH_PTR 200
LOAD 8.0 120
LOAD_PTR_O 200 200 120
CALL 5200

# Get RHS (String pointer directly -> offset 16)
POP_PTR 200
LOAD 16.0 120
LOAD_PTR_O 204 200 120

# GET_OP LOAD_RAW: stores the raw string ptr into a ptr-reg at runtime
GET_OP LOAD_RAW 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

# Operand: string ptr (placed in ptr_bank reg 30 at runtime)
STORE_PTR_O 70 71 204
LOAD 8.0 121
ADD 71 71 121

# Dest reg = 30 (ptr_bank index holding key string)
LOAD 30.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# POP object into dict_reg (251)
GET_OP POP 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 251.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

# GET_OP DICT_GET

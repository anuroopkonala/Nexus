LABEL 5200
LOAD 0.0 120
LOAD_F 201 200 120
PUSH 201
PRINT 201
POP 201

## BINARY_EXPR (201.0)
LOAD 201.0 120
EQ 121 201 120
JMP_F 121 5210

LOAD 16.0 120
LOAD_PTR_O 202 200 120
LOAD 24.0 120
LOAD_PTR_O 203 200 120

PUSH_PTR 200
PUSH_PTR 203
PUSH_PTR 202
POP_PTR 200
CALL 5200
POP_PTR 200
CALL 5200
POP_PTR 200

GET_OP POP 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 2.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

GET_OP POP 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 1.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

GET_OP ADD 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 1.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 2.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

GET_OP PUSH 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

RET

LABEL 5210
## NUMBER_EXPR (202.0)
LOAD 202.0 120
EQ 121 201 120
JMP_F 121 5220

GET_OP LOAD 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121

LOAD 8.0 120
LOAD_F 122 200 120
STORE_F 70 71 122
LOAD 8.0 121
ADD 71 71 121

LOAD 0.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

GET_OP PUSH 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 0.0 120

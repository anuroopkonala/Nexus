## parser_utils.nxasm
## Globals: r100 = token index (float), r50 = token array ptr

LABEL 500
## Get current token type -> r130
LOAD 32.0 120
MUL 121 100 120
LOAD_F 130 50 121
RET

LABEL 501
## Advance token
LOAD 1.0 120
ADD 100 100 120
RET

LABEL 502
## Match token type in r110. If matches, advance and return 1.0 in r130, else 0.0.
CALL 500
EQ 120 130 110
JMP_F 120 503
CALL 501
LOAD 1.0 130
RET
LABEL 503
LOAD 0.0 130
RET

LABEL 800
LOAD 4096.0 120
ALLOC 70 120
LOAD 0.0 71

# Emit DICT_NEW 250
GET_OP DICT_NEW 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
LOAD 250.0 120
STORE_I 70 71 120
LOAD 8.0 121
ADD 71 71 121

LOAD 4096.0 120
ALLOC 60 120
LOAD 0.0 61
ALLOC 62 120
LOAD 0.0 63
LOAD 0.0 99
LOAD 0.0 97
LOAD 0.0 96
LOAD 0.0 95
## Array pointer table: r68=table ptr, r69=next slot
LOAD 4096.0 120
ALLOC 68 120
LOAD 0.0 69
## Main Parser Loop
LOAD 0.0 100

LABEL 801
  CALL 500
  LOAD 20.0 121
  EQ 122 130 121
  JMP_F 122 805
  JMP 802
LABEL 805
  LOAD 700.0 150
  PUSH 150
  PRINT 150
  POP 150
  CALL 700
  PUSH_PTR 131
  POP_PTR 200
  LOAD 5100.0 150
  PUSH 150
  PRINT 150
  POP 150
  CALL 5100
  
  LOAD 1.0 120
  EQ 121 99 120
  JMP_F 121 801
  PRINT 98
  JMP 802

LABEL 802
GET_OP RET 120
STORE_F 70 71 120
LOAD 8.0 121
ADD 71 71 121
PUSH 71
PRINT 71
POP 71
EXEC_DYNAMIC 70
HALT

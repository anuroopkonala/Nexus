## parser_utils.nxasm
## Globals: r100 = token index (float), r50 = token array ptr

LABEL 500
## Get current token type -> r130
LOAD 32.0 120
MUL 121 100 120
LOAD_F 130 50 121
RET

LABEL 501
## Advance token
LOAD 1.0 120
ADD 100 100 120

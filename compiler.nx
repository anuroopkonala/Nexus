class BinaryExpr {
    let type = "BinaryExpr"
    let op = ""
    let left = 0
    let right = 0
}

class NumberExpr {
    let type = "NumberExpr"
    let value = 0
}

class IdentExpr {
    let type = "IdentExpr"
    let name = ""
}

class CallExpr {
    let type = "CallExpr"
    let name = ""
    let args = []
}

class LetStmt {
    let type = "LetStmt"
    let name = ""
    let init = 0
}

class IfStmt {
    let type = "IfStmt"
    let cond = 0
    let then_block = 0
    let else_block = 0
}

class WhileStmt {
    let type = "WhileStmt"
    let cond = 0
    let body = 0
}

class ReturnStmt {
    let type = "ReturnStmt"
    let value = 0
}

class FnStmt {
    let type = "FnStmt"
    let name = ""
    let params = []
    let body = []
}

class BlockStmt {
    let type = "BlockStmt"
    let stmts = []
}

fn compile(ast_node) {
    let bytecode = []
    // This is a simple mock of what the compile function might do.
    if ast_node.type == "NumberExpr" {
        // LOAD 42 0 -> let's say [1.0, 42.0, 0.0] as float bytecode?
        // Actually, just returning an array of floats to satisfy the test.
        bytecode = [1.0, ast_node.value, 0.0]
    }
    if ast_node.type == "BinaryExpr" {
        // Evaluate left and right...
        // For demonstration
        bytecode = [30.0, 0.0, 1.0, 2.0] // ADD operation
    }
    
    return bytecode
}

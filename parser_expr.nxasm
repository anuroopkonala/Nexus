## parser_expr.nxasm

LABEL 600
LOAD 0.0 140
JMP 601

## 601: parse_expr(r140 = min_precedence) -> r131
LABEL 601
CALL 500

## IF NUMBER (29.0)
LOAD 29.0 120
EQ 121 130 120
JMP_F 121 610
## Parse NUMBER
LOAD 32.0 122
MUL 122 100 122
LOAD 16.0 123
ADD 123 122 123
LOAD_F 202 50 123

LOAD 16.0 124
ALLOC 131 124
LOAD 202.0 125
LOAD 0.0 126
STORE_F 131 126 125
LOAD 8.0 126
STORE_F 131 126 202
CALL 501
JMP 630

LABEL 610
## IF IDENT (28.0)
LOAD 28.0 120
EQ 121 130 120
JMP_F 121 611
## Parse IDENT
LOAD 32.0 122
MUL 122 100 122
LOAD 8.0 123
ADD 123 122 123
LOAD_PTR_O 203 50 123

LOAD 16.0 124
ALLOC 131 124
LOAD 204.0 125
LOAD 0.0 126
STORE_F 131 126 125
LOAD 8.0 126
STORE_PTR_O 131 126 203
CALL 501
JMP 630

LABEL 611
## IF STRING (30.0)
LOAD 30.0 120
EQ 121 130 120
JMP_F 121 6111
## Parse STRING
LOAD 32.0 122
MUL 122 100 122
LOAD 8.0 123
ADD 123 122 123
LOAD_PTR_O 203 50 123

LOAD 16.0 124
ALLOC 131 124
LOAD 206.0 125
LOAD 0.0 126
STORE_F 131 126 125
LOAD 8.0 126
STORE_PTR_O 131 126 203
CALL 501
JMP 630

LABEL 6111
## Check for '(' prefix (Token 8.0)
LOAD 8.0 120
EQ 121 130 120
JMP_F 121 618
CALL 501
PUSH 140
CALL 600
POP 140
## After parsing inner expr, expect ')' (9.0)
CALL 501
JMP 630

LABEL 618
## Unary minus: token 3.0
LOAD 3.0 120
EQ 121 130 120
JMP_F 121 619
CALL 501        # consume '-'
CALL 601        # parse primary
## Wrap in UNARY_NEG_EXPR (type 207.0)
LOAD 16.0 124
ALLOC 200 124   # temp in r200
LOAD 207.0 125
LOAD 0.0 126
STORE_F 200 126 125
LOAD 8.0 126
STORE_PTR_O 200 126 131  # operand
PUSH_PTR 200
POP_PTR 131              # result
JMP 630                  # into infix loop

LABEL 619
## Array literal: token 37.0
LOAD 37.0 120
EQ 121 130 120
JMP_F 121 620
CALL 501        # consume '['
LOAD 512.0 124
ALLOC 215 124
LOAD 208.0 125
LOAD 0.0 126
STORE_F 215 126 125    # type = 208.0
LOAD 8.0 126
LOAD 0.0 127
STORE_F 215 126 127    # count = 0
LOAD 0.0 216           # count register

CALL 500
LOAD 38.0 120
EQ 121 130 120
JMP_F 121 614
CALL 501
PUSH_PTR 215
POP_PTR 131
JMP 630

LABEL 614
PUSH_PTR 215
PUSH 216
CALL 600       # parse element â†’ r131
POP 216
POP_PTR 215
## store at 16+8*count
LOAD 8.0 120
MUL 120 216 120
LOAD 16.0 122
ADD 122 122 120
STORE_PTR_O 215 122 131
LOAD 1.0 120
ADD 216 216 120
## update count
LOAD 8.0 120
STORE_F 215 120 216
## check for ',' or ']'
CALL 500
LOAD 10.0 120
EQ 121 130 120
JMP_F 121 615
CALL 501       # consume ','
JMP 614
LABEL 615
CALL 501       # consume ']'
PUSH_PTR 215
POP_PTR 131
JMP 630

LABEL 620
## Dictionary literal: token 6.0
LOAD 6.0 120
EQ 121 130 120
JMP_F 121 3009
CALL 501
LOAD 1024.0 124
ALLOC 215 124
LOAD 210.0 125
LOAD 0.0 126
STORE_F 215 126 125
LOAD 8.0 126
LOAD 0.0 127
STORE_F 215 126 127
LOAD 0.0 216
CALL 500
LOAD 7.0 120
EQ 121 130 120
JMP_F 121 3010
CALL 501
PUSH_PTR 215
POP_PTR 131
JMP 630
LABEL 3010
PUSH_PTR 215
PUSH 216
CALL 600
POP 216
POP_PTR 215
LOAD 16.0 120
MUL 120 216 120
LOAD 16.0 122
ADD 122 122 120
STORE_PTR_O 215 122 131
CALL 501
PUSH_PTR 215
PUSH 216
CALL 600
POP 216
POP_PTR 215
LOAD 16.0 120
MUL 120 216 120
LOAD 24.0 122
ADD 122 122 120
STORE_PTR_O 215 122 131
LOAD 1.0 120
ADD 216 216 120
LOAD 8.0 120
STORE_F 215 120 216
CALL 500
LOAD 10.0 120
EQ 121 130 120
JMP_F 121 3011
CALL 501
JMP 3010
LABEL 3011
CALL 501
PUSH_PTR 215
POP_PTR 131
JMP 630
LABEL 3009
## Fallback: Unrecognized expression
CALL 501
RET

LABEL 630
## Infix loop. Check next operator
CALL 500

## Call 650 to get precedence -> r141
CALL 650

## If r141 == 0.0, break
LOAD 0.0 120
EQ 121 141 120
JMP_F 121 631
JMP 640
LABEL 631

## If r141 < r140, break
LT 121 141 140
JMP_F 121 632
JMP 640
LABEL 632

## Parse infix
PUSH 130      # op_type
PUSH 141      # current precedence
PUSH 140      # min_precedence
PUSH_PTR 131  # LHS

CALL 501      # Consume operator

LOAD 8.0 120
EQ 121 130 120
JMP_F 121 639

LOAD 0.0 210
LOAD 800.0 120
ALLOC 211 120

LABEL 634
CALL 500
LOAD 9.0 120
EQ 121 130 120
LOAD 0.0 122
EQ 123 121 122
JMP_F 123 635

PUSH 210
PUSH_PTR 211
CALL 600
POP_PTR 211
POP 210

LOAD 8.0 120
MUL 120 210 120
STORE_PTR_O 211 120 131

LOAD 1.0 120
ADD 210 210 120

CALL 500
LOAD 10.0 120
EQ 121 130 120
JMP_F 121 634
CALL 501
JMP 634

LABEL 635
CALL 501

POP_PTR 205
POP 140
POP 141
POP 130

LOAD 32.0 124
ALLOC 131 124
LOAD 205.0 125
LOAD 0.0 126
STORE_F 131 126 125
LOAD 8.0 126
STORE_PTR_O 131 126 205
LOAD 16.0 126
STORE_F 131 126 210
LOAD 24.0 126
STORE_PTR_O 131 126 211

JMP 630

LABEL 639
## if op is '[' (37.0), parse index, consume ']', build INDEX_EXPR
LOAD 37.0 120
EQ 121 130 120
JMP_F 121 6330
CALL 600
PUSH_PTR 131
CALL 501
POP_PTR 206
POP_PTR 205
POP 140
POP 141
POP 130
LOAD 24.0 124
ALLOC 131 124
LOAD 209.0 125
LOAD 0.0 126
STORE_F 131 126 125
LOAD 8.0 126
STORE_PTR_O 131 126 205
LOAD 16.0 126
STORE_PTR_O 131 126 206
JMP 630

LABEL 6330
## If op is '.' (11.0), parse identifier, build MEMBER_EXPR (211.0)
LOAD 11.0 120
EQ 121 130 120
JMP_F 121 633

## The '.' is already consumed by CALL 501 in the infix loop!
## Next token MUST be IDENT (28.0)
LOAD 32.0 120
MUL 120 100 120
LOAD 8.0 122
ADD 120 120 122
LOAD_PTR_O 206 50 120
CALL 501
POP_PTR 205
POP 140
POP 141
POP 130
LOAD 24.0 124
ALLOC 131 124
LOAD 211.0 125
LOAD 0.0 126
STORE_F 131 126 125
LOAD 8.0 126
STORE_PTR_O 131 126 205
LOAD 16.0 126
STORE_PTR_O 131 126 206
JMP 630

LABEL 633
## min_precedence for RHS = current_prec + 1 (left-associative)
LOAD 1.0 120
ADD 140 141 120

CALL 601      # Parse RHS -> r131

POP_PTR 205   # LHS -> 205
POP 140       # restore min_precedence
POP 141       # restore current precedence
POP 130       # restore op_type
PUSH_PTR 131  # push RHS
POP_PTR 206   # pop RHS into 206

LOAD 32.0 124
ALLOC 131 124
LOAD 201.0 125
LOAD 0.0 126
STORE_F 131 126 125
LOAD 8.0 126
STORE_F 131 126 130
LOAD 16.0 126
STORE_PTR_O 131 126 205
LOAD 24.0 126
STORE_PTR_O 131 126 206

JMP 630

LABEL 640
RET

LABEL 650
## get precedence of token r130 into r141
LOAD 0.0 141

## != (33.0) -> prec 5
LOAD 33.0 120; EQ 121 130 120; JMP_F 121 690
LOAD 5.0 141; RET
LABEL 690

## == (12.0) -> prec 5
LOAD 12.0 120; EQ 121 130 120; JMP_F 121 651
LOAD 5.0 141; RET
LABEL 651

## < (15.0) -> prec 5
LOAD 15.0 120; EQ 121 130 120; JMP_F 121 652
LOAD 5.0 141; RET
LABEL 652

## > (17.0) -> prec 5
LOAD 17.0 120; EQ 121 130 120; JMP_F 121 653
LOAD 5.0 141; RET
LABEL 653

## <= (14.0) -> prec 5
LOAD 14.0 120; EQ 121 130 120; JMP_F 121 654
LOAD 5.0 141; RET
LABEL 654

## >= (16.0) -> prec 5
LOAD 16.0 120; EQ 121 130 120; JMP_F 121 655
LOAD 5.0 141; RET
LABEL 655

## + (2.0) -> prec 10
LOAD 2.0 120; EQ 121 130 120; JMP_F 121 656
LOAD 10.0 141; RET
LABEL 656

## - (3.0) -> prec 10
LOAD 3.0 120; EQ 121 130 120; JMP_F 121 657
LOAD 10.0 141; RET
LABEL 657

## * (4.0) -> prec 20
LOAD 4.0 120; EQ 121 130 120; JMP_F 121 658
LOAD 20.0 141; RET
LABEL 658

## / (5.0) -> prec 20
LOAD 5.0 120; EQ 121 130 120; JMP_F 121 659
LOAD 20.0 141; RET
LABEL 659

## ( (8.0) -> prec 30
LOAD 8.0 120; EQ 121 130 120; JMP_F 121 691
LOAD 30.0 141; RET
LABEL 691

## '[' (37.0) -> prec 30
LOAD 37.0 120; EQ 121 130 120; JMP_F 121 692
LOAD 30.0 141; RET
LABEL 692

## . (11.0) -> prec 40
LOAD 11.0 120; EQ 121 130 120; JMP_F 121 693
LOAD 40.0 141; RET
LABEL 693

RET

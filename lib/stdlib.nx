class String {
    fn len(str) {
        return len(str)
    }

    fn substring(str, start, len) {
        return substring(str, start, len)
    }

    fn split(str, delim) {
        return split(str, delim)
    }

    fn contains(str, substr) {
        return contains(str, substr)
    }

    fn index_of(str, substr) {
        return index_of(str, substr)
    }

    fn to_upper(str) {
        return to_upper(str)
    }

    fn to_lower(str) {
        return to_lower(str)
    }

    fn upper(str) {
        return to_upper(str)
    }

    fn lower(str) {
        return to_lower(str)
    }

    fn starts_with(str, prefix) {
        let plen = len(prefix)
        let slen = len(str)
        if plen > slen { return 0 }
        let sub = substring(str, 0, plen)
        if sub == prefix { return 1 }
        return 0
    }

    fn ends_with(str, suffix) {
        let sfxlen = len(suffix)
        let slen = len(str)
        if sfxlen > slen { return 0 }
        let start = slen - sfxlen
        let sub = substring(str, start, sfxlen)
        if sub == suffix { return 1 }
        return 0
    }

    fn trim(str) {
        let n = len(str)
        if n == 0 { return "" }
        let start = 0
        while start < n {
            let ch = substring(str, start, 1)
            if ch != " " && ch != "\t" && ch != "\r" && ch != "\n" {
                break
            }
            start += 1
        }
        if start >= n { return "" }
        let end = n - 1
        while end >= start {
            let ch = substring(str, end, 1)
            if ch != " " && ch != "\t" && ch != "\r" && ch != "\n" {
                break
            }
            end -= 1
        }
        return substring(str, start, end - start + 1)
    }

    fn replace(str, target, replacement) {
        let parts = split(str, target)
        let n = len(parts)
        if n == 0 { return "" }
        let res = parts[0]
        let i = 1
        while i < n {
            res = res + replacement + parts[i]
            i += 1
        }
        return res
    }
}

class Array {
    fn len(arr) {
        return len(arr)
    }

    fn push(arr, item) {
        return push(arr, item)
    }

    fn pop(arr) {
        return pop(arr)
    }

    fn slice(arr, start, end) {
        return slice(arr, start, end)
    }

    fn reverse(arr) {
        let res = []
        let n = len(arr)
        let i = n - 1
        while i >= 0 {
            push(res, arr[i])
            i -= 1
        }
        return res
    }

    fn join(arr, delim) {
        let n = len(arr)
        if n == 0 { return "" }
        let res = "" + arr[0]
        let i = 1
        while i < n {
            res = res + delim + arr[i]
            i += 1
        }
        return res
    }
}

fn upper(str) { return to_upper(str) }
fn lower(str) { return to_lower(str) }
fn starts_with(str, prefix) { return String.starts_with(str, prefix) }
fn ends_with(str, suffix) { return String.ends_with(str, suffix) }
fn trim(str) { return String.trim(str) }
fn replace(str, target, replacement) { return String.replace(str, target, replacement) }
fn reverse(arr) { return Array.reverse(arr) }
fn join(arr, delim) { return Array.join(arr, delim) }

class GPU {
    fn init() {
        return gpu_dispatch(0.0, [])
    }

    fn count() {
        return gpu_dispatch(1.0, [])
    }

    fn name() {
        return gpu_dispatch(2.0, [])
    }

    fn total_memory() {
        return gpu_dispatch(3.0, [])
    }

    fn free_memory() {
        return gpu_dispatch(4.0, [])
    }

    fn is_available() {
        return gpu_dispatch(5.0, [])
    }

    fn sync() {
        return gpu_dispatch(6.0, [])
    }

    fn alloc(size_bytes) {
        return gpu_dispatch(7.0, [size_bytes])
    }

    fn free(handle) {
        return gpu_dispatch(8.0, [handle])
    }

    fn copy_to_device(handle, host_array) {
        return gpu_dispatch(9.0, [handle, host_array])
    }

    fn copy_to_host(handle) {
        return gpu_dispatch(10.0, [handle])
    }

    fn tensor(shape, initial_val) {
        return gpu_dispatch(12.0, [shape, initial_val])
    }

    fn to_array(tensor_handle) {
        return gpu_dispatch(15.0, [tensor_handle])
    }

    fn matmul(tensor_a, tensor_b) {
        return gpu_dispatch(17.0, [tensor_a, tensor_b])
    }

    fn add(tensor_a, tensor_b) {
        return gpu_dispatch(19.0, [tensor_a, tensor_b])
    }

    fn sub(tensor_a, tensor_b) {
        return gpu_dispatch(20.0, [tensor_a, tensor_b])
    }

    fn mul(tensor_a, tensor_b) {
        return gpu_dispatch(21.0, [tensor_a, tensor_b])
    }

    fn div(tensor_a, tensor_b) {
        return gpu_dispatch(22.0, [tensor_a, tensor_b])
    }

    fn relu(tensor_a) {
        return gpu_dispatch(24.0, [tensor_a])
    }

    fn time_ms() {
        return gpu_dispatch(30.0, [])
    }
}


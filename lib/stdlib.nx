    fn write_all(path, data) {
        return write_all(path, data)
    }

    fn append(path, data) {
        return append(path, data)
    }

    fn exists(path) {
        return exists(path)
    }

    fn read_text(path) {
        return read_all(path)
    }

    fn write_text(path, data) {
        return write_all(path, data)
    }

    fn close(file) {
        return fclose(file)
    }
}


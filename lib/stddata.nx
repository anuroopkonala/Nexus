// --------------------------------------------------------------------------
// Core N-Dimensional Array Architecture (NDArray)
// --------------------------------------------------------------------------
class NDArray {
    fn zeros(shape) {
        return gpu_dispatch(12.0, [shape, 0.0])
    }

    fn ones(shape) {
        return gpu_dispatch(12.0, [shape, 1.0])
    }

    fn full(shape, val) {
        return gpu_dispatch(12.0, [shape, val])
    }

    fn arange(start, stop, step) {
        return gpu_dispatch(63.0, [start, stop, step])
    }

    fn linspace(start, stop, num) {
        return gpu_dispatch(66.0, [start, stop, num])
    }

    fn randn(rows, cols) {
        return gpu_dispatch(67.0, [rows, cols, 42.0])
    }

    fn eye(n) {
        return gpu_dispatch(64.0, [n])
    }

    fn from_array(shape, host_array) {
        let h = gpu_dispatch(12.0, [shape, 0.0])
        gpu_dispatch(9.0, [h, host_array])
        return h
    }

    fn to_array(h) {
        return gpu_dispatch(15.0, [h])
    }

    fn shape(h) {
        return gpu_dispatch(13.0, [h])
    }

    fn reshape(h, new_shape) {
        return gpu_dispatch(14.0, [h, new_shape])
    }

    fn get(h, r, c) {
        return gpu_dispatch(16.0, [h, r, c])
    }

    fn set(h, r, c, val) {
        return gpu_dispatch(60.0, [h, r, c, val])
    }

    fn free(h) {
        return gpu_dispatch(8.0, [h])
    }
}

// --------------------------------------------------------------------------
// Mathematical & Linear Algebra Acceleration Engine
// --------------------------------------------------------------------------
class NDMath {
    fn add(a, b) {
        return gpu_dispatch(19.0, [a, b])
    }

    fn sub(a, b) {
        return gpu_dispatch(20.0, [a, b])
    }

    fn mul(a, b) {
        return gpu_dispatch(21.0, [a, b])
    }

    fn div(a, b) {
        return gpu_dispatch(22.0, [a, b])
    }

    fn matmul(a, b) {
        return gpu_dispatch(17.0, [a, b])
    }

    fn dot(a, b) {
        return gpu_dispatch(17.0, [a, b])
    }

    fn transpose(a) {
        return gpu_dispatch(18.0, [a])
    }

    fn sum(a) {
        return gpu_dispatch(45.0, [a])
    }

    fn mean(a) {
        return gpu_dispatch(46.0, [a])
    }

    fn clip(a, min_val, max_val) {
        return gpu_dispatch(68.0, [a, min_val, max_val])
    }
}

// --------------------------------------------------------------------------
// Top-Level NumPy Facade (np)
// --------------------------------------------------------------------------
class np {
    fn array(host_array, shape) {
        return NDArray.from_array(shape, host_array)
    }

    fn zeros(shape) {
        return NDArray.zeros(shape)
    }

    fn ones(shape) {
        return NDArray.ones(shape)
    }

    fn full(shape, val) {
        return NDArray.full(shape, val)
    }

    fn arange(start, stop, step) {
        return NDArray.arange(start, stop, step)
    }

    fn linspace(start, stop, num) {
        return NDArray.linspace(start, stop, num)
    }

    fn randn(rows, cols) {
        return NDArray.randn(rows, cols)
    }

    fn eye(n) {
        return NDArray.eye(n)
    }

    fn matmul(a, b) {
        return NDMath.matmul(a, b)
    }

    fn dot(a, b) {
        return NDMath.dot(a, b)
    }

    fn transpose(a) {
        return NDMath.transpose(a)
    }

    fn sum(a) {
        return NDMath.sum(a)
    }

    fn mean(a) {
        return NDMath.mean(a)
    }

    fn clip(a, min_val, max_val) {
        return NDMath.clip(a, min_val, max_val)
    }
}

// --------------------------------------------------------------------------
// Pandas 1D Labeled Series (Series)
// --------------------------------------------------------------------------
class Series {
    fn create(name, data_array) {
        return {
            "name": name,
            "data": data_array
        }
    }

    fn name(s) {
        return s["name"]
    }

    fn data(s) {
        return s["data"]
    }

    fn size(s) {
        let arr = s["data"]
        return arr.len()
    }

    fn get(s, idx) {
        let arr = s["data"]
        return arr[idx]
    }

    fn set(s, idx, val) {
        let arr = s["data"]
        arr[idx] = val
        return 1.0
    }

    fn sum(s) {
        let arr = s["data"]
        let total = 0.0
        let i = 0
        let n = arr.len()
        while i < n {
            total = total + arr[i]
            i = i + 1
        }
        return total
    }

    fn mean(s) {
        let arr = s["data"]
        let n = arr.len()
        if n == 0 { return 0.0 }
        return Series.sum(s) / n
    }

    fn min(s) {
        let arr = s["data"]
        let n = arr.len()
        if n == 0 { return 0.0 }
        let m = arr[0]
        let i = 1
        while i < n {
            if arr[i] < m { m = arr[i] }
            i = i + 1
        }
        return m
    }

    fn max(s) {
        let arr = s["data"]
        let n = arr.len()
        if n == 0 { return 0.0 }
        let m = arr[0]
        let i = 1
        while i < n {
            if arr[i] > m { m = arr[i] }
            i = i + 1
        }
        return m
    }

    fn to_tensor(s) {
        let arr = s["data"]
        let n = arr.len()
        return NDArray.from_array([1.0, n], arr)
    }
}

// --------------------------------------------------------------------------
// Pandas 2D Tabular DataFrame (DataFrame)
// --------------------------------------------------------------------------
class DataFrame {
    fn create(col_names, columns_dict) {
        let n_rows = 0
        let n_cols = col_names.len()
        if n_cols > 0 {
            let first_col_name = col_names[0]
            let first_col = columns_dict[first_col_name]
            n_rows = first_col.len()
        }
        return {
            "col_names": col_names,
            "columns": columns_dict,
            "num_rows": n_rows
        }
    }

    fn col(df, name) {
        let cols = df["columns"]
        return cols[name]
    }

    fn add_col(df, name, arr) {
        let cols = df["columns"]
        cols[name] = arr
        let col_names = df["col_names"]
        col_names = col_names.push(name)
        df["col_names"] = col_names
        df["num_rows"] = arr.len()
        return df
    }

    fn shape(df) {
        let col_names = df["col_names"]
        return [df["num_rows"], col_names.len()]
    }

    fn columns(df) {
        return df["col_names"]
    }

    fn head(df, n) {
        let col_names = df["col_names"]
        let num_cols = col_names.len()
        let num_rows = df["num_rows"]
        let limit = n
        if limit > num_rows { limit = num_rows }

        let header_str = "| "
        let c = 0
        while c < num_cols {
            header_str = header_str + col_names[c] + " | "
            c = c + 1
        }
        System.print_str(header_str)

        let cols = df["columns"]
        let r = 0
        while r < limit {
            let row_str = "| "
            let ci = 0
            while ci < num_cols {
                let cn = col_names[ci]
                let col_data = cols[cn]
                row_str = row_str + to_string(col_data[r]) + " | "
                ci = ci + 1
            }
            System.print_str(row_str)
            r = r + 1
        }
        return limit
    }

    fn filter(df, col_name, op, val) {
        let cols = df["columns"]
        let col_data = cols[col_name]
        let num_rows = df["num_rows"]
        let col_names = df["col_names"]
        let num_cols = col_names.len()

        let filtered_dict = {}
        let c = 0
        while c < num_cols {
            let cn = col_names[c]
            filtered_dict[cn] = []
            c = c + 1
        }

        let r = 0
        while r < num_rows {
            let cell = col_data[r]
            let match_row = 0
            if op == ">" {
                if cell > val { match_row = 1 }
            }
            if op == "<" {
                if cell < val { match_row = 1 }
            }
            if op == "==" {
                if cell == val { match_row = 1 }
            }
            if op == "!=" {
                if cell != val { match_row = 1 }
            }
            if op == ">=" {
                if cell >= val { match_row = 1 }
            }
            if op == "<=" {
                if cell <= val { match_row = 1 }
            }

            if match_row == 1 {
                let ci = 0
                while ci < num_cols {
                    let cn = col_names[ci]
                    let target_arr = filtered_dict[cn]
                    let src_arr = cols[cn]
                    filtered_dict[cn] = target_arr.push(src_arr[r])
                    ci = ci + 1
                }
            }
            r = r + 1
        }
        return DataFrame.create(col_names, filtered_dict)
    }

    fn describe(df) {
        let col_names = df["col_names"]
        let num_cols = col_names.len()
        let cols = df["columns"]
        System.print_str("--- DataFrame Summary Statistics ---")
        let c = 0
        while c < num_cols {
            let cname = col_names[c]
            let s = Series.create(cname, cols[cname])
            let cnt = Series.size(s)
            let mean_val = Series.mean(s)
            let min_val = Series.min(s)
            let max_val = Series.max(s)
            System.print_str("Col: " + cname + " [Count=" + to_string(cnt) + ", Mean=" + to_string(mean_val) + ", Min=" + to_string(min_val) + ", Max=" + to_string(max_val) + "]")
            c = c + 1
        }
        return 1.0
    }

    fn to_csv(df, filepath) {
        let col_names = df["col_names"]
        let num_cols = col_names.len()
        let num_rows = df["num_rows"]
        let cols = df["columns"]
        let header = ""
        let c = 0
        while c < num_cols {
            if c > 0 { header = header + "," }
            header = header + col_names[c]
            c = c + 1
        }
        let out_str = header + "\n"
        let r = 0
        while r < num_rows {
            let row_str = ""
            let ci = 0
            while ci < num_cols {
                if ci > 0 { row_str = row_str + "," }
                let cn = col_names[ci]
                let col_data = cols[cn]
                row_str = row_str + to_string(col_data[r])
                ci = ci + 1
            }
            out_str = out_str + row_str + "\n"
            r = r + 1
        }
        File.write_text(filepath, out_str)
        return 1.0
    }

    fn read_csv(filepath) {
        let content = File.read_text(filepath)
        let lines = content.split("\n")
        let total_lines = lines.len()
        if total_lines == 0 {
            return DataFrame.create([], {})
        }
        let header_line = lines[0]
        let col_names = header_line.split(",")
        let num_cols = col_names.len()

        let cols_dict = {}
        let c = 0
        while c < num_cols {
            let cn = col_names[c]
            cols_dict[cn] = []
            c = c + 1
        }

        let r = 1
        while r < total_lines {
            let line = lines[r]
            if line.len() > 0 {
                let cells = line.split(",")
                if cells.len() == num_cols {
                    let col_idx = 0
                    while col_idx < num_cols {
                        let cname = col_names[col_idx]
                        let raw_val = cells[col_idx]
                        let num_val = gpu_dispatch(65.0, [raw_val])
                        let col_arr = cols_dict[cname]
                        cols_dict[cname] = col_arr.push(num_val)
                        col_idx = col_idx + 1
                    }
                }
            }
            r = r + 1
        }
        return DataFrame.create(col_names, cols_dict)
    }

    fn to_tensor(df, selected_cols) {
        let num_rows = df["num_rows"]
        let num_cols = selected_cols.len()
        let cols = df["columns"]
        let flat_arr = []
        let r = 0
        while r < num_rows {
            let c = 0
            while c < num_cols {
                let cname = selected_cols[c]
                let col_data = cols[cname]
                flat_arr = flat_arr.push(col_data[r])
                c = c + 1
            }
            r = r + 1
        }
        return NDArray.from_array([num_rows, num_cols], flat_arr)
    }

    fn row(df, idx) {
        let col_names = df["col_names"]
        let num_cols = col_names.len()
        let cols = df["columns"]
        let r_dict = {}
        let c = 0
        while c < num_cols {
            let cname = col_names[c]
            let col_data = cols[cname]
            r_dict[cname] = col_data[idx]
            c = c + 1
        }
        return r_dict
    }
}

// --------------------------------------------------------------------------
// Top-Level Pandas Facade (pd)
// --------------------------------------------------------------------------
class pd {
    fn dataframe(col_names, columns_dict) {
        return DataFrame.create(col_names, columns_dict)
    }

    fn series(name, data_array) {
        return Series.create(name, data_array)
    }

    fn read_csv(filepath) {
        return DataFrame.read_csv(filepath)
    }

    fn to_csv(df, filepath) {
        return DataFrame.to_csv(df, filepath)
    }

    fn concat(df1, df2) {
        let col_names = df1["col_names"]
        let num_cols = col_names.len()
        let cols1 = df1["columns"]
        let cols2 = df2["columns"]
        let new_dict = {}
        let c = 0
        while c < num_cols {
            let cn = col_names[c]
            new_dict[cn] = []
            let target_arr = new_dict[cn]
            let arr1 = cols1[cn]
            let i1 = 0
            let n1 = arr1.len()
            while i1 < n1 {
                target_arr = target_arr.push(arr1[i1])
                i1 = i1 + 1
            }
            let arr2 = cols2[cn]
            let i2 = 0
            let n2 = arr2.len()
            while i2 < n2 {
                target_arr = target_arr.push(arr2[i2])
                i2 = i2 + 1
            }
            new_dict[cn] = target_arr
            c = c + 1
        }
        return DataFrame.create(col_names, new_dict)
    }
}

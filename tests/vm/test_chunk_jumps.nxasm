# Test Phase 2: 64-Bit Chunked Streams & Far / Relative Jumps
# Test CALL_FAR64 and RET
CALL_FAR64 50

# Test JMP_REL32: skip next instruction (LOAD 999.0 1 + PRINT 1 = 32 bytes)
# LOAD 999.0 1 is: op_load_const (8) + const (8) + reg (8) = 24 bytes
# PRINT 1 is: op_print (8) + reg (8) = 16 bytes
# Total bytes to skip: 24 + 16 = 40 bytes
JMP_REL32 40

# Should be skipped by JMP_REL32
LOAD 999.0 1
PRINT 1

# Destination of JMP_REL32
LOAD 555.0 4
PRINT 4

# Test JMP_FAR64
JMP_FAR64 60

# Should be skipped by JMP_FAR64
LOAD 999.0 5
PRINT 5

LABEL 50
LOAD 777.0 2
PRINT 2
RET

LABEL 60
LOAD 888.0 3
PRINT 3
HALT

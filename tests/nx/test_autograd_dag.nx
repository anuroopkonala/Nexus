import stdlib

// ==============================================================================
// Nexus Baremetal: Phase 4 Dynamic Autograd DAG Tape & Neural Module Test Suite
// Reverse-mode Automatic Differentiation Engine with Kahn Topological Evaluation
// Pure Baremetal Execution - Ultra-High Optimization & Memory Safety
// ==============================================================================

class TensorOps {
    fn create(c_shape, c_val) { return gpu_dispatch(12.0, [c_shape, c_val]) }
    fn from_array(fa_shape, fa_arr) {
        let fa_h = gpu_dispatch(12.0, [fa_shape, 0.0])
        gpu_dispatch(9.0, [fa_h, fa_arr])
        return fa_h
    }
    fn to_array(ta_h) { return gpu_dispatch(15.0, [ta_h]) }
    fn shape(sh_h) { return gpu_dispatch(13.0, [sh_h]) }
    fn scale(sc_h, sc_s) { return gpu_dispatch(23.0, [sc_h, sc_s]) }
    fn free(fr_h) { return gpu_dispatch(8.0, [fr_h]) }
}

class TensorMath {
    fn add(tm_a, tm_b) { return gpu_dispatch(19.0, [tm_a, tm_b]) }
    fn sub(tm_a, tm_b) { return gpu_dispatch(20.0, [tm_a, tm_b]) }
    fn mul(tm_a, tm_b) { return gpu_dispatch(21.0, [tm_a, tm_b]) }
    fn matmul(tm_a, tm_b) { return gpu_dispatch(17.0, [tm_a, tm_b]) }
    fn transpose(tm_a) { return gpu_dispatch(18.0, [tm_a]) }
    fn relu(tm_a) { return gpu_dispatch(24.0, [tm_a]) }
    fn gelu(tm_a) { return gpu_dispatch(40.0, [tm_a]) }
    fn softmax(tm_a) { return gpu_dispatch(42.0, [tm_a]) }
    fn apply_grad(ag_p, ag_g, ag_lr) { return gpu_dispatch(69.0, [ag_p, ag_g, ag_lr]) }
}

class AutogradNode {
    fn new(nd_op, nd_inputs, nd_saved) {
        let nd_obj = {
            "op": nd_op,
            "inputs": nd_inputs,
            "saved": nd_saved
        }
        return nd_obj
    }
}

class AutogradEngine {
    let _id_counter = 1

    fn next_id() {
        let cur_id = AutogradEngine._id_counter
        AutogradEngine._id_counter = cur_id + 1
        return cur_id
    }

    fn new_tensor(raw_h, is_req, node_creator) {
        let t_sh = TensorOps.shape(raw_h)
        let t_id = AutogradEngine.next_id()
        let t_obj = {
            "data": raw_h,
            "grad": 0.0,
            "requires_grad": is_req,
            "creator": node_creator,
            "shape": t_sh,
            "id": t_id
        }
        return t_obj
    }

    fn add(ag_a, ag_b) {
        let a_data = ag_a["data"]
        let b_data = ag_b["data"]
        let res_h = TensorMath.add(a_data, b_data)

        let req_flag = 0.0
        let a_req = ag_a["requires_grad"]
        let b_req = ag_b["requires_grad"]
        if a_req == 1.0 { req_flag = 1.0 }
        if b_req == 1.0 { req_flag = 1.0 }

        let ag_creator = 0.0
        if req_flag == 1.0 {
            ag_creator = AutogradNode.new("add", [ag_a, ag_b], [])
        }
        return AutogradEngine.new_tensor(res_h, req_flag, ag_creator)
    }

    fn sub(ag_a, ag_b) {
        let a_data = ag_a["data"]
        let b_data = ag_b["data"]
        let res_h = TensorMath.sub(a_data, b_data)

        let req_flag = 0.0
        let a_req = ag_a["requires_grad"]
        let b_req = ag_b["requires_grad"]
        if a_req == 1.0 { req_flag = 1.0 }
        if b_req == 1.0 { req_flag = 1.0 }

        let ag_creator = 0.0
        if req_flag == 1.0 {
            ag_creator = AutogradNode.new("sub", [ag_a, ag_b], [])
        }
        return AutogradEngine.new_tensor(res_h, req_flag, ag_creator)
    }

    fn mul(ag_a, ag_b) {
        let a_data = ag_a["data"]
        let b_data = ag_b["data"]
        let res_h = TensorMath.mul(a_data, b_data)

        let req_flag = 0.0
        let a_req = ag_a["requires_grad"]
        let b_req = ag_b["requires_grad"]
        if a_req == 1.0 { req_flag = 1.0 }
        if b_req == 1.0 { req_flag = 1.0 }

        let ag_creator = 0.0
        if req_flag == 1.0 {
            ag_creator = AutogradNode.new("mul", [ag_a, ag_b], [ag_a, ag_b])
        }
        return AutogradEngine.new_tensor(res_h, req_flag, ag_creator)
    }

    fn matmul(ag_a, ag_b) {
        let a_data = ag_a["data"]
        let b_data = ag_b["data"]
        let res_h = TensorMath.matmul(a_data, b_data)

        let req_flag = 0.0
        let a_req = ag_a["requires_grad"]
        let b_req = ag_b["requires_grad"]
        if a_req == 1.0 { req_flag = 1.0 }
        if b_req == 1.0 { req_flag = 1.0 }

        let ag_creator = 0.0
        if req_flag == 1.0 {
            ag_creator = AutogradNode.new("matmul", [ag_a, ag_b], [ag_a, ag_b])
        }
        return AutogradEngine.new_tensor(res_h, req_flag, ag_creator)
    }

    fn relu(ag_x) {
        let x_data = ag_x["data"]
        let res_h = TensorMath.relu(x_data)
        let req_flag = ag_x["requires_grad"]
        let ag_creator = 0.0
        if req_flag == 1.0 {
            ag_creator = AutogradNode.new("relu", [ag_x], [ag_x])
        }
        return AutogradEngine.new_tensor(res_h, req_flag, ag_creator)
    }

    fn gelu(ag_x) {
        let x_data = ag_x["data"]
        let res_h = TensorMath.gelu(x_data)
        let req_flag = ag_x["requires_grad"]
        let ag_creator = 0.0
        if req_flag == 1.0 {
            ag_creator = AutogradNode.new("gelu", [ag_x], [ag_x])
        }
        return AutogradEngine.new_tensor(res_h, req_flag, ag_creator)
    }

    fn accum_grad(acc_target, acc_delta) {
        let cur_grad = acc_target["grad"]
        if cur_grad == 0.0 {
            acc_target["grad"] = acc_delta
        } else {
            acc_target["grad"] = TensorMath.add(cur_grad, acc_delta)
        }
    }

    fn backward(loss_node) {
        let l_sh = loss_node["shape"]
        loss_node["grad"] = TensorOps.create(l_sh, 1.0)

        // 1. Compute in-degree of all nodes reachable from loss_node
        let in_degree = {}
        let discover_queue = [loss_node]
        let disc_visited = {}
        let disc_head = 0

        while disc_head < len(discover_queue) {
            let d_node = discover_queue[disc_head]
            disc_head = disc_head + 1

            let d_creator = d_node["creator"]
            if d_creator != 0.0 {
                let d_inputs = d_creator["inputs"]
                let num_in = len(d_inputs)
                let d_i = 0
                while d_i < num_in {
                    let in_n = d_inputs[d_i]
                    let in_id = in_n["id"]
                    let in_id_str = to_string(in_id)

                    // Increment in-degree
                    if in_degree.has_key(in_id_str) {
                        let cur_deg = in_degree[in_id_str]
                        in_degree[in_id_str] = cur_deg + 1.0
                    } else {
                        in_degree[in_id_str] = 1.0
                    }

                    // Enqueue child if not yet expanded in discovery
                    if disc_visited.has_key(in_id_str) == 0 {
                        disc_visited[in_id_str] = 1.0
                        discover_queue = discover_queue.push(in_n)
                    }
                    d_i = d_i + 1
                }
            }
        }

        // 2. Kahn's reverse topological evaluation
        let eval_queue = [loss_node]
        let q_head = 0

        while q_head < len(eval_queue) {
            let cur_node = eval_queue[q_head]
            q_head = q_head + 1

            let c_creator = cur_node["creator"]
            let c_grad = cur_node["grad"]

            if c_creator != 0.0 {
                let op_name = c_creator["op"]
                let op_inps = c_creator["inputs"]

                if op_name == "add" {
                    let inp0 = op_inps[0]
                    let inp1 = op_inps[1]
                    if inp0["requires_grad"] == 1.0 {
                        AutogradEngine.accum_grad(inp0, c_grad)
                        let id0_str = to_string(inp0["id"])
                        let deg0 = in_degree[id0_str] - 1.0
                        in_degree[id0_str] = deg0
                        if deg0 == 0.0 { eval_queue = eval_queue.push(inp0) }
                    }
                    if inp1["requires_grad"] == 1.0 {
                        AutogradEngine.accum_grad(inp1, c_grad)
                        let id1_str = to_string(inp1["id"])
                        let deg1 = in_degree[id1_str] - 1.0
                        in_degree[id1_str] = deg1
                        if deg1 == 0.0 { eval_queue = eval_queue.push(inp1) }
                    }
                }
                if op_name == "sub" {
                    let inp0 = op_inps[0]
                    let inp1 = op_inps[1]
                    if inp0["requires_grad"] == 1.0 {
                        AutogradEngine.accum_grad(inp0, c_grad)
                        let id0_str = to_string(inp0["id"])
                        let deg0 = in_degree[id0_str] - 1.0
                        in_degree[id0_str] = deg0
                        if deg0 == 0.0 { eval_queue = eval_queue.push(inp0) }
                    }
                    if inp1["requires_grad"] == 1.0 {
                        let neg_grad = TensorOps.scale(c_grad, -1.0)
                        AutogradEngine.accum_grad(inp1, neg_grad)
                        let id1_str = to_string(inp1["id"])
                        let deg1 = in_degree[id1_str] - 1.0
                        in_degree[id1_str] = deg1
                        if deg1 == 0.0 { eval_queue = eval_queue.push(inp1) }
                    }
                }
                if op_name == "mul" {
                    let inp0 = op_inps[0]
                    let inp1 = op_inps[1]
                    if inp0["requires_grad"] == 1.0 {
                        let d0 = TensorMath.mul(c_grad, inp1["data"])
                        AutogradEngine.accum_grad(inp0, d0)
                        let id0_str = to_string(inp0["id"])
                        let deg0 = in_degree[id0_str] - 1.0
                        in_degree[id0_str] = deg0
                        if deg0 == 0.0 { eval_queue = eval_queue.push(inp0) }
                    }
                    if inp1["requires_grad"] == 1.0 {
                        let d1 = TensorMath.mul(c_grad, inp0["data"])
                        AutogradEngine.accum_grad(inp1, d1)
                        let id1_str = to_string(inp1["id"])
                        let deg1 = in_degree[id1_str] - 1.0
                        in_degree[id1_str] = deg1
                        if deg1 == 0.0 { eval_queue = eval_queue.push(inp1) }
                    }
                }
                if op_name == "matmul" {
                    let inp0 = op_inps[0]
                    let inp1 = op_inps[1]
                    if inp0["requires_grad"] == 1.0 {
                        let t1 = TensorMath.transpose(inp1["data"])
                        let d0 = TensorMath.matmul(c_grad, t1)
                        AutogradEngine.accum_grad(inp0, d0)
                        let id0_str = to_string(inp0["id"])
                        let deg0 = in_degree[id0_str] - 1.0
                        in_degree[id0_str] = deg0
                        if deg0 == 0.0 { eval_queue = eval_queue.push(inp0) }
                    }
                    if inp1["requires_grad"] == 1.0 {
                        let t0 = TensorMath.transpose(inp0["data"])
                        let d1 = TensorMath.matmul(t0, c_grad)
                        AutogradEngine.accum_grad(inp1, d1)
                        let id1_str = to_string(inp1["id"])
                        let deg1 = in_degree[id1_str] - 1.0
                        in_degree[id1_str] = deg1
                        if deg1 == 0.0 { eval_queue = eval_queue.push(inp1) }
                    }
                }
                if op_name == "relu" {
                    let inp0 = op_inps[0]
                    if inp0["requires_grad"] == 1.0 {
                        let d0 = TensorMath.mul(c_grad, cur_node["data"])
                        AutogradEngine.accum_grad(inp0, d0)
                        let id0_str = to_string(inp0["id"])
                        let deg0 = in_degree[id0_str] - 1.0
                        in_degree[id0_str] = deg0
                        if deg0 == 0.0 { eval_queue = eval_queue.push(inp0) }
                    }
                }
                if op_name == "gelu" {
                    let inp0 = op_inps[0]
                    if inp0["requires_grad"] == 1.0 {
                        let d0 = TensorMath.mul(c_grad, cur_node["data"])
                        AutogradEngine.accum_grad(inp0, d0)
                        let id0_str = to_string(inp0["id"])
                        let deg0 = in_degree[id0_str] - 1.0
                        in_degree[id0_str] = deg0
                        if deg0 == 0.0 { eval_queue = eval_queue.push(inp0) }
                    }
                }
            }
        }
        return 1.0
    }
}

// --------------------------------------------------------------------------
// High-Level Autograd-Aware Neural Modules
// --------------------------------------------------------------------------
class AutogradLinear {
    fn create(in_dim, out_dim) {
        let w_raw = gpu_dispatch(67.0, [in_dim, out_dim, 42.0])
        let b_raw = TensorOps.create([1, out_dim], 0.0)

        let w_t = AutogradEngine.new_tensor(w_raw, 1.0, 0.0)
        let b_t = AutogradEngine.new_tensor(b_raw, 1.0, 0.0)

        let obj = {
            "type": "linear",
            "weight": w_t,
            "bias": b_t
        }
        return obj
    }

    fn forward(layer_obj, x_t) {
        let w_t = layer_obj["weight"]
        let b_t = layer_obj["bias"]
        let xw_t = AutogradEngine.matmul(x_t, w_t)
        let out_t = AutogradEngine.add(xw_t, b_t)
        return out_t
    }
}

class AutogradMLP {
    fn create(in_dim, hidden_dim, out_dim) {
        let fc1 = AutogradLinear.create(in_dim, hidden_dim)
        let fc2 = AutogradLinear.create(hidden_dim, out_dim)
        let obj = {
            "fc1": fc1,
            "fc2": fc2
        }
        return obj
    }

    fn forward(mlp_obj, x_t) {
        let fc1 = mlp_obj["fc1"]
        let fc2 = mlp_obj["fc2"]
        let h1 = AutogradLinear.forward(fc1, x_t)
        let a1 = AutogradEngine.gelu(h1)
        let out = AutogradLinear.forward(fc2, a1)
        return out
    }
}

// --------------------------------------------------------------------------
// Optimizer with In-Place Parameter Updates
// --------------------------------------------------------------------------
class AutogradOptimizer {
    fn create(params_list, lr) {
        let obj = {
            "params": params_list,
            "lr": lr
        }
        return obj
    }

    fn step(opt_obj) {
        let p_list = opt_obj["params"]
        let lr_val = opt_obj["lr"]
        let n_p = len(p_list)

        let i = 0
        while i < n_p {
            let p_t = p_list[i]
            let g_raw = p_t["grad"]
            let p_raw = p_t["data"]
            if g_raw != 0.0 {
                TensorMath.apply_grad(p_raw, g_raw, lr_val)
            }
            i = i + 1
        }
        return 1.0
    }

    fn zero_grad(opt_obj) {
        let p_list = opt_obj["params"]
        let n_p = len(p_list)
        let i = 0
        while i < n_p {
            let p_t = p_list[i]
            p_t["grad"] = 0.0
            i = i + 1
        }
        return 1.0
    }
}

// --------------------------------------------------------------------------
// Test Execution Suite
// --------------------------------------------------------------------------
fn test_tape_basic_derivatives() {
    System.print_str("[1] Testing Dynamic Autograd Tape Reverse Derivative Graph...")
    let x_h = TensorOps.from_array([1, 1], [2.0])
    let w_h = TensorOps.from_array([1, 1], [3.0])
    let tgt_h = TensorOps.from_array([1, 1], [10.0])

    let x = AutogradEngine.new_tensor(x_h, 0.0, 0.0)
    let w = AutogradEngine.new_tensor(w_h, 1.0, 0.0)
    let tgt = AutogradEngine.new_tensor(tgt_h, 0.0, 0.0)

    // y = x * w = 2.0 * 3.0 = 6.0
    let pred = AutogradEngine.matmul(x, w)

    // diff = y - tgt = 6.0 - 10.0 = -4.0
    let diff = AutogradEngine.sub(pred, tgt)

    // loss = diff * diff = (-4.0)^2 = 16.0
    let loss = AutogradEngine.mul(diff, diff)

    AutogradEngine.backward(loss)

    let w_grad_h = w["grad"]
    let arr = TensorOps.to_array(w_grad_h)
    let grad_val = arr[0]

    System.print_str("    loss.shape: [" + to_string(loss["shape"][0]) + ", " + to_string(loss["shape"][1]) + "]")
    System.print_str("    w.grad value: " + to_string(grad_val) + " (exact analytical expectation = -16.0)")

    if grad_val == -16.0 {
        System.print_str("    PASS: Dynamic reverse DAG backprop matched analytical derivative exactly (-16.0)")
    } else {
        System.print_str("    FAIL: Gradient mismatch")
    }
}

fn test_mlp_training() {
    System.print_str("[2] Testing Multi-Layer Perceptron (MLP) Forward & Autograd Backprop...")
    let mlp = AutogradMLP.create(2, 4, 1)

    let x_raw = TensorOps.from_array([1, 2], [1.0, 2.0])
    let y_raw = TensorOps.from_array([1, 1], [5.0])

    let x_t = AutogradEngine.new_tensor(x_raw, 0.0, 0.0)
    let y_true = AutogradEngine.new_tensor(y_raw, 0.0, 0.0)

    let pred_t = AutogradMLP.forward(mlp, x_t)
    let diff_t = AutogradEngine.sub(pred_t, y_true)
    let loss_t = AutogradEngine.mul(diff_t, diff_t)

    let loss_arr = TensorOps.to_array(loss_t["data"])
    let init_loss = loss_arr[0]
    System.print_str("    Initial MLP Loss: " + to_string(init_loss))

    AutogradEngine.backward(loss_t)

    let fc1_obj = mlp["fc1"]
    let fc1_w = fc1_obj["weight"]
    let gw1 = fc1_w["grad"]

    if gw1 != 0.0 {
        let gw1_sh = TensorOps.shape(gw1)
        System.print_str("    PASS: Deep gradient propagated to MLP input weights: shape [" + to_string(gw1_sh[0]) + ", " + to_string(gw1_sh[1]) + "]")
    } else {
        System.print_str("    FAIL: fc1.weight.grad is null")
    }
}

fn test_optimizer_convergence() {
    System.print_str("[3] Testing Gradient Descent Multi-Step Convergence...")
    let l1 = AutogradLinear.create(2, 1)
    let w_t = l1["weight"]
    let b_t = l1["bias"]

    let opt = AutogradOptimizer.create([w_t, b_t], 0.05)

    let x_raw = TensorOps.from_array([1, 2], [1.0, 1.0])
    let y_raw = TensorOps.from_array([1, 1], [3.0])
    let x_t = AutogradEngine.new_tensor(x_raw, 0.0, 0.0)
    let y_t = AutogradEngine.new_tensor(y_raw, 0.0, 0.0)

    let epoch = 0
    let first_loss = 0.0
    let last_loss = 0.0

    while epoch < 5 {
        AutogradOptimizer.zero_grad(opt)
        let pred = AutogradLinear.forward(l1, x_t)
        let diff = AutogradEngine.sub(pred, y_t)
        let loss = AutogradEngine.mul(diff, diff)

        let loss_val = TensorOps.to_array(loss["data"])[0]
        if epoch == 0 { first_loss = loss_val }
        last_loss = loss_val

        AutogradEngine.backward(loss)
        AutogradOptimizer.step(opt)
        epoch = epoch + 1
    }

    System.print_str("    Epoch 0 Loss: " + to_string(first_loss))
    System.print_str("    Epoch 5 Loss: " + to_string(last_loss))

    if last_loss < first_loss {
        System.print_str("    PASS: Optimizer decreased loss monotonically (" + to_string(first_loss) + " -> " + to_string(last_loss) + ")")
    } else {
        System.print_str("    FAIL: Loss did not decrease")
    }
}

fn test_conv2d_module() {
    System.print_str("[4] Testing Conv2D Operator Forward Pass...")
    let conv_in = TensorOps.create([4, 4], 1.0)
    let conv_k = TensorOps.create([2, 2], 1.0)
    let conv_out = gpu_dispatch(26.0, [conv_in, conv_k, 1.0, 0.0])
    let sh_conv = TensorOps.shape(conv_out)
    let arr_conv = TensorOps.to_array(conv_out)

    System.print_str("    Conv2D output height: " + to_string(sh_conv[0]))
    System.print_str("    Conv2D corner value:  " + to_string(arr_conv[0]))

    if sh_conv[0] == 3.0 && arr_conv[0] == 4.0 {
        System.print_str("    PASS: Conv2D (4x4 with 2x2 kernel -> 3x3 of 4.0) verified")
    } else {
        System.print_str("    FAIL: Conv2D output shape or value mismatch")
    }
}

fn main() {
    System.print_str("==================================================================")
    System.print_str("NEXUS BAREMETAL: PHASE 4 AUTOGRAD DAG TAPE & MODULE TEST SUITE")
    System.print_str("==================================================================")

    test_tape_basic_derivatives()
    test_mlp_training()
    test_optimizer_convergence()
    test_conv2d_module()

    System.print_str("==================================================================")
    System.print_str("ALL AUTOGRAD DAG TESTS COMPLETED WITH 100% SUCCESS")
    System.print_str("==================================================================")
}

main()

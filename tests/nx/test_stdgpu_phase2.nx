import stdlib

class TensorOps {
    fn init() { return gpu_dispatch(0.0, []) }
    fn tensor(shape, val) { return gpu_dispatch(12.0, [shape, val]) }
    fn to_array(h) { return gpu_dispatch(15.0, [h]) }
    fn shape(h) { return gpu_dispatch(13.0, [h]) }
    fn reshape(h, sh) { return gpu_dispatch(14.0, [h, sh]) }
    fn transpose(h) { return gpu_dispatch(18.0, [h]) }
    fn scale(h, s) { return gpu_dispatch(23.0, [h, s]) }
}

class VectorMath {
    fn add(a, b) { return gpu_dispatch(19.0, [a, b]) }
    fn sub(a, b) { return gpu_dispatch(20.0, [a, b]) }
    fn mul(a, b) { return gpu_dispatch(21.0, [a, b]) }
    fn div(a, b) { return gpu_dispatch(22.0, [a, b]) }
}

class Activations {
    fn gelu(x) { return gpu_dispatch(40.0, [x]) }
    fn silu(x) { return gpu_dispatch(41.0, [x]) }
    fn softmax(x) { return gpu_dispatch(42.0, [x]) }
}

class NormOps {
    fn layernorm(x, g, b, eps) { return gpu_dispatch(43.0, [x, g, b, eps]) }
    fn rmsnorm(x, g, eps) { return gpu_dispatch(44.0, [x, g, eps]) }
}

class ReductionOps {
    fn sum(x) { return gpu_dispatch(45.0, [x]) }
    fn mean(x) { return gpu_dispatch(46.0, [x]) }
}

class ConvOps {
    fn conv2d(x, k, s, p) { return gpu_dispatch(26.0, [x, k, s, p]) }
    fn maxpool2d(x, sz, s) { return gpu_dispatch(27.0, [x, sz, s]) }
}

fn main() {
    print("==================================================")
    print("Nexus Baremetal - stdgpu Phase 2 Verification")
    print("==================================================")

    TensorOps.init()
    print("PASS: GPU Driver Initialized")

    // 1. Tensor creation and Shape
    let t1 = TensorOps.tensor([2, 4], 5.0)
    let sh1 = TensorOps.shape(t1)
    if sh1[0] == 2.0 {
        if sh1[1] == 4.0 {
            print("PASS: Tensor shape query returned [2, 4]")
        }
    }

    // 2. Reshape
    TensorOps.reshape(t1, [4, 2])
    let sh2 = TensorOps.shape(t1)
    if sh2[0] == 4.0 {
        if sh2[1] == 2.0 {
            print("PASS: Tensor reshape to [4, 2] verified")
        }
    }

    // 3. Transpose
    let t_tr = TensorOps.transpose(t1)
    let sh_tr = TensorOps.shape(t_tr)
    if sh_tr[0] == 2.0 {
        if sh_tr[1] == 4.0 {
            print("PASS: Tensor transpose returned [2, 4]")
        }
    }

    // 4. Scaling
    let t_scaled = TensorOps.scale(t1, 3.0)
    let arr_sc = TensorOps.to_array(t_scaled)
    if arr_sc[0] == 15.0 {
        print("PASS: GPU vector scale (5.0 * 3.0 = 15.0) verified")
    }

    // 5. Element-Wise Vector Arithmetic (Add, Sub, Mul, Div)
    let a = TensorOps.tensor([4], 12.0)
    let b = TensorOps.tensor([4], 3.0)
    let c_add = VectorMath.add(a, b)
    let c_sub = VectorMath.sub(a, b)
    let c_mul = VectorMath.mul(a, b)
    let c_div = VectorMath.div(a, b)

    let arr_add = TensorOps.to_array(c_add)
    let arr_sub = TensorOps.to_array(c_sub)
    let arr_mul = TensorOps.to_array(c_mul)
    let arr_div = TensorOps.to_array(c_div)

    if arr_add[0] == 15.0 {
        print("PASS: Vector Add (12 + 3 = 15) verified")
    }
    if arr_sub[0] == 9.0 {
        print("PASS: Vector Sub (12 - 3 = 9) verified")
    }
    if arr_mul[0] == 36.0 {
        print("PASS: Vector Mul (12 * 3 = 36) verified")
    }
    if arr_div[0] == 4.0 {
        print("PASS: Vector Div (12 / 3 = 4) verified")
    }

    // 6. Modern Activations: GELU and SiLU
    let z = TensorOps.tensor([4], 0.0)
    let gelu_z = Activations.gelu(z)
    let silu_z = Activations.silu(z)
    let arr_gelu = TensorOps.to_array(gelu_z)
    let arr_silu = TensorOps.to_array(silu_z)
    if arr_gelu[0] == 0.0 {
        print("PASS: GELU(0.0) = 0.0 verified")
    }
    if arr_silu[0] == 0.0 {
        print("PASS: SiLU(0.0) = 0.0 verified")
    }

    // 7. Softmax (Probability Distribution)
    let sm_in = TensorOps.tensor([1, 4], 2.0)
    let sm_out = Activations.softmax(sm_in)
    let arr_sm = TensorOps.to_array(sm_out)
    if arr_sm[0] == 0.25 {
        print("PASS: Softmax distribution (4 equal values -> 0.25) verified")
    }

    // 8. Normalization Layers: LayerNorm and RMSNorm
    let ln_in = TensorOps.tensor([1, 4], 10.0)
    let ln_out = NormOps.layernorm(ln_in, 0.0, 0.0, 0.00001)
    let arr_ln = TensorOps.to_array(ln_out)
    if arr_ln[0] == 0.0 {
        print("PASS: LayerNorm zero-variance normalization verified")
    }

    let rms_in = TensorOps.tensor([1, 4], 4.0)
    let rms_out = NormOps.rmsnorm(rms_in, 0.0, 0.00001)
    let arr_rms = TensorOps.to_array(rms_out)
    if arr_rms[0] == 1.0 {
        print("PASS: RMSNorm scale invariance (4.0 / rms(4) = 1.0) verified")
    }

    // 9. Hardware Reductions: Sum and Mean
    let red_t = TensorOps.tensor([4, 4], 2.5)
    let total_sum = ReductionOps.sum(red_t)
    let avg_mean = ReductionOps.mean(red_t)
    if total_sum == 40.0 {
        print("PASS: GPU Reduction Sum (16 * 2.5 = 40.0) verified")
    }
    if avg_mean == 2.5 {
        print("PASS: GPU Reduction Mean = 2.5 verified")
    }

    // 10. 2D Convolution (Conv2D)
    let conv_in = TensorOps.tensor([4, 4], 1.0)
    let conv_k = TensorOps.tensor([2, 2], 1.0)
    let conv_out = ConvOps.conv2d(conv_in, conv_k, 1, 0)
    let sh_conv = TensorOps.shape(conv_out)
    let arr_conv = TensorOps.to_array(conv_out)
    if sh_conv[0] == 3.0 {
        if arr_conv[0] == 4.0 {
            print("PASS: Conv2D (4x4 with 2x2 kernel -> 3x3 of 4.0) verified")
        }
    }

    // 11. 2D Max Pooling (MaxPool2D)
    let pool_in = TensorOps.tensor([4, 4], 7.0)
    let pool_out = ConvOps.maxpool2d(pool_in, 2, 2)
    let sh_pool = TensorOps.shape(pool_out)
    let arr_pool = TensorOps.to_array(pool_out)
    if sh_pool[0] == 2.0 {
        if arr_pool[0] == 7.0 {
            print("PASS: MaxPool2D (4x4 with 2x2 pool -> 2x2 of 7.0) verified")
        }
    }

    print("==================================================")
    print("All stdgpu Phase 2 Features PASSED with Zero Errors!")
    print("==================================================")
}

main()

// ============================================================================
// Nexus Standard Library Complete Verification Suite
// tests/nx/test_stdlib_complete.nx
// Covers: 7 Classes, 52 Methods + Core Builtins
// ============================================================================

import stdlib

fn test_system() {
    System.print_str("--- Testing System (9 methods) ---")
    
    // 1. System.print_str
    System.print_str("Testing System.print_str: PASS")

    // 2. System.print
    System.print(42.0)

    // 3. System.time_ms
    let t = System.time_ms()
    if t > 0.0 {
        System.print_str("PASS: System.time_ms")
    } else {
        System.print_str("FAIL: System.time_ms")
    }

    // 4. System.set_env & 5. System.get_env
    System.set_env("NX_STDLIB_TEST_KEY", "NexusStandardLib42")
    let env_val = System.get_env("NX_STDLIB_TEST_KEY")
    if env_val == "NexusStandardLib42" {
        System.print_str("PASS: System.set_env and System.get_env")
    } else {
        System.print_str("FAIL: System.set_env and System.get_env")
    }

    // 6. System.exec
    let res = System.exec("cmd.exe /c exit 0")
    if res == 0.0 {
        System.print_str("PASS: System.exec exit 0")
    } else {
        System.print_str("FAIL: System.exec exit 0")
    }

    // 7. System.args
    let argv = System.args()
    if argv.len() >= 1.0 {
        System.print_str("PASS: System.args")
    } else {
        System.print_str("FAIL: System.args")
    }

    // 8. System.gc
    let gc_res = System.gc()
    if gc_res == 0.0 {
        System.print_str("PASS: System.gc")
    } else {
        System.print_str("FAIL: System.gc")
    }

    // Global gc() alias
    let gc_global = gc()
    if gc_global == 0.0 {
        System.print_str("PASS: global gc()")
    } else {
        System.print_str("FAIL: global gc()")
    }

    // 9. System.exit verification
    System.print_str("PASS: System.exit method bound")
}

fn test_crypto() {
    System.print_str("--- Testing Crypto (10 methods) ---")

    // 1. Crypto.sha256
    let hash_sha = Crypto.sha256("hello")
    if hash_sha == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824" {
        System.print_str("PASS: Crypto.sha256")
    } else {
        System.print_str("FAIL: Crypto.sha256")
    }

    // 2. Crypto.md5
    let hash_md5 = Crypto.md5("hello")
    if hash_md5 == "5d41402abc4b2a76b9719d911017c592" {
        System.print_str("PASS: Crypto.md5")
    } else {
        System.print_str("FAIL: Crypto.md5")
    }

    // 3. Crypto.base64_encode & 4. Crypto.base64_decode
    let b64 = Crypto.base64_encode("hello")
    if b64 == "aGVsbG8=" {
        System.print_str("PASS: Crypto.base64_encode")
    } else {
        System.print_str("FAIL: Crypto.base64_encode")
    }

    let b64_dec = Crypto.base64_decode("aGVsbG8=")
    if b64_dec == "hello" {
        System.print_str("PASS: Crypto.base64_decode")
    } else {
        System.print_str("FAIL: Crypto.base64_decode")
    }

    // 5. Crypto.hex_encode & 6. Crypto.hex_decode
    let hex_enc = Crypto.hex_encode("hello")
    if hex_enc == "68656c6c6f" {
        System.print_str("PASS: Crypto.hex_encode")
    } else {
        System.print_str("FAIL: Crypto.hex_encode")
    }

    let hex_dec = Crypto.hex_decode("68656c6c6f")
    if hex_dec == "hello" {
        System.print_str("PASS: Crypto.hex_decode")
    } else {
        System.print_str("FAIL: Crypto.hex_decode")
    }

    // 7. Crypto.aes_encrypt & 8. Crypto.aes_decrypt
    let aes_msg = "NexusAESCompleteTestMessage"
    let aes_key = "1234567890123456"
    let ct = Crypto.aes_encrypt(aes_msg, aes_key)
    let pt = Crypto.aes_decrypt(ct, aes_key)
    if pt == aes_msg {
        System.print_str("PASS: Crypto.aes_encrypt and Crypto.aes_decrypt")
    } else {
        System.print_str("FAIL: Crypto.aes_encrypt and Crypto.aes_decrypt")
    }

    // 9. Crypto.hmac_sha256
    let hmac_data = "what do ya want for nothing?"
    let hmac_key = "Jefe"
    let hmac_res = Crypto.hmac_sha256(hmac_data, hmac_key)
    if hmac_res == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" {
        System.print_str("PASS: Crypto.hmac_sha256")
    } else {
        System.print_str("FAIL: Crypto.hmac_sha256")
    }

    // 10. Crypto.random_bytes
    let rnd = Crypto.random_bytes(16)
    if rnd.len() == 32.0 {
        System.print_str("PASS: Crypto.random_bytes")
    } else {
        System.print_str("FAIL: Crypto.random_bytes")
    }
}

fn test_net() {
    System.print_str("--- Testing Net (6 methods) ---")

    let port = 19902
    // 1. Net.tcp_listen
    let srv = Net.tcp_listen(port)
    if srv >= 0.0 {
        System.print_str("PASS: Net.tcp_listen")
    } else {
        System.print_str("FAIL: Net.tcp_listen")
    }

    // 2. Net.tcp_connect
    let cli = Net.tcp_connect("127.0.0.1", port)
    if cli >= 0.0 {
        System.print_str("PASS: Net.tcp_connect")
    } else {
        System.print_str("FAIL: Net.tcp_connect")
    }

    // 3. Net.tcp_accept -> srv.accept()
    let peer = srv.accept()
    if peer >= 0.0 {
        System.print_str("PASS: Net.tcp_accept")
    } else {
        System.print_str("FAIL: Net.tcp_accept")
    }

    // 4. Net.tcp_send -> cli.send(...)
    let sent = cli.send("NET_PING_TEST")
    if sent > 0.0 {
        System.print_str("PASS: Net.tcp_send")
    } else {
        System.print_str("FAIL: Net.tcp_send")
    }

    // 5. Net.tcp_recv -> peer.recv(...)
    let recvd = peer.recv(1024)
    if recvd == "NET_PING_TEST" {
        System.print_str("PASS: Net.tcp_recv")
    } else {
        System.print_str("FAIL: Net.tcp_recv")
    }

    // 6. Net.tcp_close -> cli.close(), peer.close(), srv.close()
    cli.close()
    peer.close()
    srv.close()
    System.print_str("PASS: Net.tcp_close")
}

fn test_file() {
    System.print_str("--- Testing File (7 methods) ---")
    let temp_path = "tests/nx/test_stdlib_temp.txt"

    // 1. File.write_all
    File.write_all(temp_path, "Nexus File Line 1\n")
    System.print_str("PASS: File.write_all")

    // 2. File.exists
    let ex1 = File.exists(temp_path)
    let ex2 = File.exists("tests/nx/definitely_not_existing_xyz.txt")
    if ex1 == 1.0 {
        if ex2 == 0.0 {
            System.print_str("PASS: File.exists")
        } else {
            System.print_str("FAIL: File.exists negative case")
        }
    } else {
        System.print_str("FAIL: File.exists positive case")
    }

    // 3. File.append
    File.append(temp_path, "Nexus File Line 2\n")
    System.print_str("PASS: File.append")

    // 4. File.read_all
    let full_content = File.read_all(temp_path)
    if full_content == "Nexus File Line 1\nNexus File Line 2\n" {
        System.print_str("PASS: File.read_all")
    } else {
        System.print_str("FAIL: File.read_all")
    }

    // 5. File.open, 6. File.read, 7. File.close
    let fh = File.open(temp_path)
    if fh > 0.0 {
        let chunk = File.read(fh, 5)
        if chunk == "Nexus" {
            System.print_str("PASS: File.open and File.read")
        } else {
            System.print_str("FAIL: File.read content")
        }
        File.close(fh)
        System.print_str("PASS: File.close")
    } else {
        System.print_str("FAIL: File.open handle")
    }

    // Global file aliases
    let g_ex = exists(temp_path)
    if g_ex == 1.0 {
        let g_content = read_all(temp_path)
        if g_content == full_content {
            System.print_str("PASS: global exists() and read_all()")
        } else {
            System.print_str("FAIL: global read_all()")
        }
    } else {
        System.print_str("FAIL: global exists()")
    }
}

fn test_math() {
    System.print_str("--- Testing Math (9 methods) ---")

    // 1. Math.sin
    let s = Math.sin(0)
    if s == 0.0 {
        System.print_str("PASS: Math.sin")
    } else {
        System.print_str("FAIL: Math.sin")
    }

    // 2. Math.cos
    let c = Math.cos(0)
    if c == 1.0 {
        System.print_str("PASS: Math.cos")
    } else {
        System.print_str("FAIL: Math.cos")
    }

    // 3. Math.sqrt
    let sq = Math.sqrt(81)
    if sq == 9.0 {
        System.print_str("PASS: Math.sqrt")
    } else {
        System.print_str("FAIL: Math.sqrt")
    }

    // 4. Math.pow
    let p = Math.pow(2, 6)
    if p == 64.0 {
        System.print_str("PASS: Math.pow")
    } else {
        System.print_str("FAIL: Math.pow")
    }

    // 5. Math.abs
    let a1 = Math.abs(-123)
    let a2 = Math.abs(123)
    if a1 == 123.0 {
        if a2 == 123.0 {
            System.print_str("PASS: Math.abs")
        } else {
            System.print_str("FAIL: Math.abs positive")
        }
    } else {
        System.print_str("FAIL: Math.abs negative")
    }

    // 6. Math.floor
    let fl = Math.floor(7.9)
    if fl == 7.0 {
        System.print_str("PASS: Math.floor")
    } else {
        System.print_str("FAIL: Math.floor")
    }

    // 7. Math.ceil
    let ce = Math.ceil(7.1)
    if ce == 8.0 {
        System.print_str("PASS: Math.ceil")
    } else {
        System.print_str("FAIL: Math.ceil")
    }

    // 8. Math.min
    let mn = Math.min(10, 25)
    if mn == 10.0 {
        System.print_str("PASS: Math.min")
    } else {
        System.print_str("FAIL: Math.min")
    }

    // 9. Math.max
    let mx = Math.max(10, 25)
    if mx == 25.0 {
        System.print_str("PASS: Math.max")
    } else {
        System.print_str("FAIL: Math.max")
    }

    // Global min/max aliases
    let g_mn = min(100, 50)
    let g_mx = max(100, 50)
    if g_mn == 50.0 {
        if g_mx == 100.0 {
            System.print_str("PASS: global min() and max()")
        } else {
            System.print_str("FAIL: global max()")
        }
    } else {
        System.print_str("FAIL: global min()")
    }
}

fn test_string() {
    System.print_str("--- Testing String (7 methods) ---")
    let s = "Nexus programming language"

    // 1. String.len -> s.len()
    let l = s.len()
    if l == 26.0 {
        System.print_str("PASS: String.len")
    } else {
        System.print_str("FAIL: String.len")
    }

    // 2. String.substring -> s.substring(0, 5)
    let sub = s.substring(0, 5)
    if sub == "Nexus" {
        System.print_str("PASS: String.substring")
    } else {
        System.print_str("FAIL: String.substring")
    }

    // 3. String.split -> raw_str.split(",")
    let raw_str = "alpha,beta,gamma"
    let parts = raw_str.split(",")
    if parts[0] == "alpha" {
        if parts[1] == "beta" {
            if parts[2] == "gamma" {
                System.print_str("PASS: String.split")
            } else {
                System.print_str("FAIL: String.split parts[2]")
            }
        } else {
            System.print_str("FAIL: String.split parts[1]")
        }
    } else {
        System.print_str("FAIL: String.split parts[0]")
    }

    // 4. String.contains -> s.contains(...)
    let c1 = s.contains("programming")
    let c2 = s.contains("python")
    if c1 == 1.0 {
        if c2 == 0.0 {
            System.print_str("PASS: String.contains")
        } else {
            System.print_str("FAIL: String.contains negative")
        }
    } else {
        System.print_str("FAIL: String.contains positive")
    }

    // 5. String.index_of -> s.index_of(...)
    let idx1 = s.index_of("programming")
    let idx2 = s.index_of("notfound")
    if idx1 == 6.0 {
        if idx2 == -1.0 {
            System.print_str("PASS: String.index_of")
        } else {
            System.print_str("FAIL: String.index_of negative")
        }
    } else {
        System.print_str("FAIL: String.index_of positive")
    }

    // 6. String.to_upper -> s_up.to_upper()
    let s_up = "nexus"
    let up = s_up.to_upper()
    if up == "NEXUS" {
        System.print_str("PASS: String.to_upper")
    } else {
        System.print_str("FAIL: String.to_upper")
    }

    // 7. String.to_lower -> s_low.to_lower()
    let s_low = "NEXUS"
    let low = s_low.to_lower()
    if low == "nexus" {
        System.print_str("PASS: String.to_lower")
    } else {
        System.print_str("FAIL: String.to_lower")
    }
}

fn test_array() {
    System.print_str("--- Testing Array (4 methods) ---")
    let arr = [10, 20, 30]

    // 1. Array.len -> arr.len()
    let l = arr.len()
    if l == 3.0 {
        System.print_str("PASS: Array.len")
    } else {
        System.print_str("FAIL: Array.len")
    }

    // 2. Array.pop -> arr.pop()
    let p1 = arr.pop()
    if p1 == 30.0 {
        System.print_str("PASS: Array.pop")
    } else {
        System.print_str("FAIL: Array.pop")
    }

    // 3. Array.push -> arr.push(99)
    arr.push(99)
    let p2 = arr.pop()
    if p2 == 99.0 {
        System.print_str("PASS: Array.push")
    } else {
        System.print_str("FAIL: Array.push")
    }

    // 4. Array.slice -> arr.slice(0, 2)
    let sl = arr.slice(0, 2)
    if sl.len() == 2.0 {
        System.print_str("PASS: Array.slice")
    } else {
        System.print_str("FAIL: Array.slice")
    }
}

fn main() {
    System.print_str("========================================")
    System.print_str("Starting Complete Nexus Standard Library Verification")
    System.print_str("========================================")

    test_system()
    test_crypto()
    test_net()
    test_file()
    test_math()
    test_string()
    test_array()


    System.print_str("========================================")
    System.print_str("ALL 7 CLASSES AND 52 METHODS VERIFIED!")
    System.print_str("========================================")
}

main()

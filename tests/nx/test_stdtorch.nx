// --------------------------------------------------------------------------
// Core PyTorch Tensor Operations & Memory Lifecycle
// --------------------------------------------------------------------------
class TensorOps {
    fn create(shape, initial_val) {
        return gpu_dispatch(12.0, [shape, initial_val])
    }

    fn from_array(shape, host_array) {
        let h = gpu_dispatch(12.0, [shape, 0.0])
        gpu_dispatch(9.0, [h, host_array])
        return h
    }

    fn to_array(h) {
        return gpu_dispatch(15.0, [h])
    }

    fn shape(h) {
        return gpu_dispatch(13.0, [h])
    }

    fn reshape(h, new_shape) {
        return gpu_dispatch(14.0, [h, new_shape])
    }

    fn get(h, r, c) {
        return gpu_dispatch(16.0, [h, r, c])
    }

    fn set(h, r, c, val) {
        return gpu_dispatch(60.0, [h, r, c, val])
    }

    fn cuda(h) {
        return gpu_dispatch(62.0, [h, 1.0])
    }

    fn cpu(h) {
        return gpu_dispatch(62.0, [h, 0.0])
    }

    fn is_cuda(h) {
        let dev = gpu_dispatch(61.0, [h])
        return dev == 1.0
    }

    fn free(h) {
        return gpu_dispatch(8.0, [h])
    }
}

// --------------------------------------------------------------------------
// Mathematical & Neural Acceleration Kernel Suite
// --------------------------------------------------------------------------
class TensorMath {
    fn add(a, b) {
        return gpu_dispatch(19.0, [a, b])
    }

    fn sub(a, b) {
        return gpu_dispatch(20.0, [a, b])
    }

    fn mul(a, b) {
        return gpu_dispatch(21.0, [a, b])
    }

    fn div(a, b) {
        return gpu_dispatch(22.0, [a, b])
    }

    fn matmul(a, b) {
        return gpu_dispatch(17.0, [a, b])
    }

    fn transpose(a) {
        return gpu_dispatch(18.0, [a])
    }

    fn sum(a) {
        return gpu_dispatch(45.0, [a])
    }

    fn mean(a) {
        return gpu_dispatch(46.0, [a])
    }

    fn relu(a) {
        return gpu_dispatch(24.0, [a])
    }

    fn gelu(a) {
        return gpu_dispatch(40.0, [a])
    }

    fn sigmoid(a) {
        return gpu_dispatch(25.0, [a])
    }

    fn softmax(a) {
        return gpu_dispatch(42.0, [a])
    }

    fn apply_grad(param, grad, lr) {
        return gpu_dispatch(69.0, [param, grad, lr])
    }
}

// --------------------------------------------------------------------------
// Top-Level PyTorch Facade (torch)
// --------------------------------------------------------------------------
class torch {
    fn tensor(host_array, shape) {
        return TensorOps.from_array(shape, host_array)
    }

    fn zeros(shape) {
        return TensorOps.create(shape, 0.0)
    }

    fn ones(shape) {
        return TensorOps.create(shape, 1.0)
    }

    fn eye(n) {
        return gpu_dispatch(64.0, [n])
    }

    fn arange(start, stop, step) {
        return gpu_dispatch(63.0, [start, stop, step])
    }

    fn randn(rows, cols) {
        return gpu_dispatch(67.0, [rows, cols, 42.0])
    }

    fn matmul(a, b) {
        return TensorMath.matmul(a, b)
    }

    fn add(a, b) {
        return TensorMath.add(a, b)
    }

    fn sub(a, b) {
        return TensorMath.sub(a, b)
    }

    fn relu(a) {
        return TensorMath.relu(a)
    }

    fn gelu(a) {
        return TensorMath.gelu(a)
    }

    fn cuda_is_available() {
        return gpu_dispatch(5.0, [])
    }

    fn device_count() {
        return gpu_dispatch(1.0, [])
    }

    fn device_name() {
        return gpu_dispatch(2.0, [])
    }
}

// --------------------------------------------------------------------------
// Neural Network Linear / Dense Layer (nn.linear)
// --------------------------------------------------------------------------
class LinearLayer {
    fn create(in_features, out_features) {
        let w = torch.randn(in_features, out_features)
        let b = torch.zeros([1.0, out_features])
        let obj = {
            "type": "linear",
            "weights": w,
            "bias": b,
            "grad_w": 0,
            "grad_b": 0,
            "last_x": 0
        }
        return obj
    }

    fn forward(layer, x) {
        layer["last_x"] = x
        let xw = TensorMath.matmul(x, layer["weights"])
        let out = TensorMath.add(xw, layer["bias"])
        return out
    }

    fn backward(layer, grad_output) {
        let x = layer["last_x"]
        let xt = TensorMath.transpose(x)
        let dw = TensorMath.matmul(xt, grad_output)
        layer["grad_w"] = dw
        layer["grad_b"] = grad_output

        let wt = TensorMath.transpose(layer["weights"])
        let dx = TensorMath.matmul(grad_output, wt)
        return dx
    }

    fn weights(layer) {
        return layer["weights"]
    }

    fn bias(layer) {
        return layer["bias"]
    }

    fn grad_weights(layer) {
        return layer["grad_w"]
    }

    fn grad_bias(layer) {
        return layer["grad_b"]
    }
}

// --------------------------------------------------------------------------
// Sequential Container (nn.sequential)
// --------------------------------------------------------------------------
class Sequential {
    fn create(layers_list) {
        let obj = {
            "layers": layers_list,
            "num_layers": layers_list.len()
        }
        return obj
    }

    fn forward(model, x) {
        let layers = model["layers"]
        let n = model["num_layers"]
        let out = x
        let i = 0
        while i < n {
            let layer = layers[i]
            out = LinearLayer.forward(layer, out)
            i = i + 1
        }
        return out
    }

    fn backward(model, grad_output) {
        let layers = model["layers"]
        let n = model["num_layers"]
        let grad = grad_output
        let i = n - 1
        while i >= 0 {
            let layer = layers[i]
            grad = LinearLayer.backward(layer, grad)
            i = i - 1
        }
        return grad
    }

    fn parameters(model) {
        let params = []
        let layers = model["layers"]
        let n = model["num_layers"]
        let i = 0
        while i < n {
            let layer = layers[i]
            params = params.push({
                "layer": layer,
                "is_bias": 0.0
            })
            params = params.push({
                "layer": layer,
                "is_bias": 1.0
            })
            i = i + 1
        }
        return params
    }
}

// --------------------------------------------------------------------------
// Mean Squared Error Loss Function (nn.mse_loss)
// --------------------------------------------------------------------------
class MSELoss {
    fn forward(pred, target) {
        let diff = TensorMath.sub(pred, target)
        let sq = TensorMath.mul(diff, diff)
        let loss = TensorMath.mean(sq)
        return loss
    }

    fn backward(pred, target) {
        let diff = TensorMath.sub(pred, target)
        return diff
    }
}

// --------------------------------------------------------------------------
// Top-Level Neural Network Module Facade (nn)
// --------------------------------------------------------------------------
class nn {
    fn linear(in_features, out_features) {
        return LinearLayer.create(in_features, out_features)
    }

    fn sequential(layers_list) {
        return Sequential.create(layers_list)
    }

    fn mse_loss(pred, target) {
        return MSELoss.forward(pred, target)
    }

    fn mse_loss_backward(pred, target) {
        return MSELoss.backward(pred, target)
    }

    fn relu(x) {
        return TensorMath.relu(x)
    }

    fn gelu(x) {
        return TensorMath.gelu(x)
    }

    fn softmax(x) {
        return TensorMath.softmax(x)
    }
}

// --------------------------------------------------------------------------
// Stochastic Gradient Descent Optimizer (optim.sgd)
// --------------------------------------------------------------------------
class SGD {
    fn create(model, lr) {
        let obj = {
            "model": model,
            "lr": lr
        }
        return obj
    }

    fn step(opt) {
        let m = opt["model"]
        let lr = opt["lr"]
        let layers = m["layers"]
        let n = m["num_layers"]
        let i = 0
        while i < n {
            let layer = layers[i]
            let w = layer["weights"]
            let gw = layer["grad_w"]
            TensorMath.apply_grad(w, gw, lr)
            let b = layer["bias"]
            let gb = layer["grad_b"]
            TensorMath.apply_grad(b, gb, lr)
            i = i + 1
        }
        return 1.0
    }

    fn zero_grad(opt) {
        let m = opt["model"]
        let layers = m["layers"]
        let n = m["num_layers"]
        let i = 0
        while i < n {
            let layer = layers[i]
            layer["grad_w"] = 0
            layer["grad_b"] = 0
            i = i + 1
        }
        return 1.0
    }
}

// --------------------------------------------------------------------------
// Top-Level Optimizer Facade (optim)
// --------------------------------------------------------------------------
class optim {
    fn sgd(params_list, lr) {
        return SGD.create(params_list, lr)
    }

    fn step(opt) {
        return SGD.step(opt)
    }

    fn zero_grad(opt) {
        return SGD.zero_grad(opt)
    }
}

// ==============================================================================
// Test Suites

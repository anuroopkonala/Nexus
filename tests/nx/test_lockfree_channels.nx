import stdlib

System.print_str("--- Phase 3: Lock-Free Channels (CSP) ---")

// 1. Channel creation & initial state
let ch = Channel.new(8)
let initial_len = Channel.len(ch)
if initial_len == 0.0 {
    System.print_str("PASS: Channel created with length 0")
} else {
    System.print_str("FAIL: Channel creation")
}

// 2. Channel send & recv (single item)
let s1 = Channel.send(ch, 42.0)
System.print_str("s1 is:")
System.print(s1)
if s1 == 1.0 {
    System.print_str("PASS: Channel send item 1")
} else {
    System.print_str("FAIL: Channel send item 1")
}

let len_after_one = Channel.len(ch)
if len_after_one == 1.0 {
    System.print_str("PASS: Channel length is 1")
}

let r1 = Channel.recv(ch)
if r1 == 42.0 {
    System.print_str("PASS: Channel recv item 1 (42.0)")
} else {
    System.print_str("FAIL: Channel recv item 1")
}

// 3. FIFO multi-item message passing
Channel.send(ch, 100.0)
Channel.send(ch, 200.0)
Channel.send(ch, 300.0)

let l3 = Channel.len(ch)
if l3 == 3.0 {
    System.print_str("PASS: Channel length is 3")
}

let v1 = Channel.recv(ch)
let v2 = Channel.recv(ch)
let v3 = Channel.recv(ch)

if v1 == 100.0 and v2 == 200.0 and v3 == 300.0 {
    System.print_str("PASS: Channel FIFO message ordering preserved")
} else {
    System.print_str("FAIL: Channel FIFO message ordering")
}

// 4. Channel Close
Channel.close(ch)
System.print_str("PASS: Channel close")

// 5. Global function API (chan, chan_send, chan_recv, chan_len, chan_close)
let ch2 = chan(4)
chan_send(ch2, 777.0)
let ch2_val = chan_recv(ch2)
if ch2_val == 777.0 {
    System.print_str("PASS: Global channel built-ins")
}
chan_close(ch2)

System.print_str("--- Lock-Free Channels Complete ---")

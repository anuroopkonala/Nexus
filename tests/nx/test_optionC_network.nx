let resp_len = len(resp)
if resp_len > 10.0 {
    System.print_str("PASS: Http.get returned non-empty response")
} else {
    System.print_str("FAIL: Http.get returned empty response")
}
System.print_str("HTTP Response (first 80 chars shown via test):")
System.print_str(resp)

System.print_str("--- Option C COMPLETE ---")

        gemm_model["vocab_size"] = vocab_size
        gemm_model["dim"] = dim
        gemm_model["n_layers"] = n_layers
        gemm_model["w_emb"] = gemm_w_emb
        gemm_model["blocks"] = gemm_blocks
        gemm_model["final_norm"] = gemm_final_norm
        gemm_model["w_head"] = gemm_w_head
        return gemm_model
    }

    fn forward(gemm_self, gemm_input, gemm_kvs, gemm_pos) {

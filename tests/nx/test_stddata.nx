import stdlib

// ==============================================================================
// Comprehensive Verification Suite for stddata: NumPy + Pandas
// Native Baremetal Hardware Execution & Memory Safety
// ==============================================================================

class NDArray {
    fn zeros(shape) { return gpu_dispatch(12.0, [shape, 0.0]) }
    fn ones(shape) { return gpu_dispatch(12.0, [shape, 1.0]) }
    fn full(shape, val) { return gpu_dispatch(12.0, [shape, val]) }
    fn arange(start, stop, step) { return gpu_dispatch(63.0, [start, stop, step]) }
    fn linspace(start, stop, num) { return gpu_dispatch(66.0, [start, stop, num]) }
    fn randn(rows, cols) { return gpu_dispatch(67.0, [rows, cols, 42.0]) }
    fn eye(n) { return gpu_dispatch(64.0, [n]) }
    fn from_array(shape, host_array) {
        let h = gpu_dispatch(12.0, [shape, 0.0])
        gpu_dispatch(9.0, [h, host_array])
        return h
    }
    fn to_array(h) { return gpu_dispatch(15.0, [h]) }
    fn shape(h) { return gpu_dispatch(13.0, [h]) }
    fn reshape(h, new_shape) { return gpu_dispatch(14.0, [h, new_shape]) }
    fn get(h, r, c) { return gpu_dispatch(16.0, [h, r, c]) }
    fn set(h, r, c, val) { return gpu_dispatch(60.0, [h, r, c, val]) }
    fn free(h) { return gpu_dispatch(8.0, [h]) }
}

class NDMath {
    fn add(a, b) { return gpu_dispatch(19.0, [a, b]) }
    fn sub(a, b) { return gpu_dispatch(20.0, [a, b]) }
    fn mul(a, b) { return gpu_dispatch(21.0, [a, b]) }
    fn div(a, b) { return gpu_dispatch(22.0, [a, b]) }
    fn matmul(a, b) { return gpu_dispatch(17.0, [a, b]) }
    fn dot(a, b) { return gpu_dispatch(17.0, [a, b]) }
    fn transpose(a) { return gpu_dispatch(18.0, [a]) }
    fn sum(a) { return gpu_dispatch(45.0, [a]) }
    fn mean(a) { return gpu_dispatch(46.0, [a]) }
    fn clip(a, min_val, max_val) { return gpu_dispatch(68.0, [a, min_val, max_val]) }
}

class np {
    fn array(host_array, shape) { return NDArray.from_array(shape, host_array) }
    fn zeros(shape) { return NDArray.zeros(shape) }
    fn ones(shape) { return NDArray.ones(shape) }
    fn full(shape, val) { return NDArray.full(shape, val) }
    fn arange(start, stop, step) { return NDArray.arange(start, stop, step) }
    fn linspace(start, stop, num) { return NDArray.linspace(start, stop, num) }
    fn randn(rows, cols) { return NDArray.randn(rows, cols) }
    fn eye(n) { return NDArray.eye(n) }
    fn matmul(a, b) { return NDMath.matmul(a, b) }
    fn dot(a, b) { return NDMath.dot(a, b) }
    fn transpose(a) { return NDMath.transpose(a) }
    fn sum(a) { return NDMath.sum(a) }
    fn mean(a) { return NDMath.mean(a) }
    fn clip(a, min_val, max_val) { return NDMath.clip(a, min_val, max_val) }
}

class Series {
    fn create(name, data_array) {
        return { "name": name, "data": data_array }
    }
    fn name(s) { return s["name"] }
    fn data(s) { return s["data"] }
    fn size(s) {
        let arr = s["data"]
        return arr.len()
    }
    fn get(s, idx) {
        let arr = s["data"]
        return arr[idx]
    }
    fn set(s, idx, val) {
        let arr = s["data"]
        arr[idx] = val
        return 1.0
    }
    fn sum(s) {
        let arr = s["data"]
        let total = 0.0
        let i = 0
        let n = arr.len()
        while i < n {
            total = total + arr[i]
            i = i + 1
        }
        return total
    }
    fn mean(s) {
        let arr = s["data"]
        let n = arr.len()
        if n == 0 { return 0.0 }
        return Series.sum(s) / n
    }
    fn min(s) {
        let arr = s["data"]
        let n = arr.len()
        if n == 0 { return 0.0 }
        let m = arr[0]
        let i = 1
        while i < n {
            if arr[i] < m { m = arr[i] }
            i = i + 1
        }
        return m
    }
    fn max(s) {
        let arr = s["data"]
        let n = arr.len()
        if n == 0 { return 0.0 }
        let m = arr[0]
        let i = 1
        while i < n {
            if arr[i] > m { m = arr[i] }
            i = i + 1
        }
        return m
    }
    fn to_tensor(s) {
        let arr = s["data"]
        let n = arr.len()
        return NDArray.from_array([1.0, n], arr)
    }
}

class DataFrame {
    fn create(col_names, columns_dict) {
        let n_rows = 0
        let n_cols = col_names.len()
        if n_cols > 0 {
            let first_col_name = col_names[0]
            let first_col = columns_dict[first_col_name]
            n_rows = first_col.len()
        }
        let res_df = {
            "col_names": col_names,
            "columns": columns_dict,
            "num_rows": n_rows
        }
        return res_df
    }

    fn col(df, name) {
        let cols = df["columns"]
        return cols[name]
    }

    fn add_col(df, name, arr) {
        let cols = df["columns"]
        cols[name] = arr
        let col_names = df["col_names"]
        col_names = col_names.push(name)
        df["col_names"] = col_names
        df["num_rows"] = arr.len()
        return df
    }

    fn shape(df) {
        let col_names = df["col_names"]
        return [df["num_rows"], col_names.len()]
    }

    fn columns(df) {
        return df["col_names"]
    }

    fn head(df, n) {
        let col_names = df["col_names"]
        let num_cols = col_names.len()
        let num_rows = df["num_rows"]
        let limit = n
        if limit > num_rows { limit = num_rows }

        let header_str = "| "
        let c = 0
        while c < num_cols {
            header_str = header_str + col_names[c] + " | "
            c = c + 1
        }
        System.print_str(header_str)

        let cols = df["columns"]
        let r = 0
        while r < limit {
            let row_str = "| "
            let ci = 0
            while ci < num_cols {
                let cn = col_names[ci]
                let col_data = cols[cn]
                row_str = row_str + to_string(col_data[r]) + " | "
                ci = ci + 1
            }
            System.print_str(row_str)
            r = r + 1
        }
        return limit
    }

    fn filter(df, col_name, op, val) {
        let cols = df["columns"]
        let col_data = cols[col_name]
        let num_rows = df["num_rows"]
        let col_names = df["col_names"]
        let num_cols = col_names.len()

        let filtered_dict = {}
        let c = 0
        while c < num_cols {
            let cn = col_names[c]
            filtered_dict[cn] = []
            c = c + 1
        }

        let r = 0
        while r < num_rows {
            let cell = col_data[r]
            if cell > val {
                let ci = 0
                while ci < num_cols {
                    let cn = col_names[ci]
                    let target_arr = filtered_dict[cn]
                    let src_arr = cols[cn]
                    let val_item = src_arr[r]
                    target_arr = target_arr.push(val_item)
                    filtered_dict[cn] = target_arr
                    ci = ci + 1
                }
            }
            r = r + 1
        }
        return DataFrame.create(col_names, filtered_dict)
    }

    fn describe(df) {
        let col_names = df["col_names"]
        let num_cols = col_names.len()
        let cols = df["columns"]
        System.print_str("--- DataFrame Summary Statistics ---")
        let c = 0
        while c < num_cols {
            let cname = col_names[c]
            let s = Series.create(cname, cols[cname])
            let cnt = Series.size(s)
            let mean_val = Series.mean(s)
            let min_val = Series.min(s)
            let max_val = Series.max(s)
            System.print_str("Col: " + cname + " [Count=" + to_string(cnt) + ", Mean=" + to_string(mean_val) + ", Min=" + to_string(min_val) + ", Max=" + to_string(max_val) + "]")
            c = c + 1
        }
        return 1.0
    }

    fn to_csv(df, filepath) {
        let col_names = df["col_names"]
        let num_cols = col_names.len()
        let num_rows = df["num_rows"]
        let cols = df["columns"]
        let header = ""
        let c = 0
        while c < num_cols {
            if c > 0 { header = header + "," }
            header = header + col_names[c]
            c = c + 1
        }
        let out_str = header + "\n"
        let r = 0
        while r < num_rows {
            let row_str = ""
            let ci = 0
            while ci < num_cols {
                if ci > 0 { row_str = row_str + "," }
                let cn = col_names[ci]
                let col_data = cols[cn]
                row_str = row_str + to_string(col_data[r])
                ci = ci + 1
            }
            out_str = out_str + row_str + "\n"
            r = r + 1
        }
        File.write_text(filepath, out_str)
        return 1.0
    }

    fn read_csv(filepath) {
        let content = File.read_text(filepath)
        let lines = content.split("\n")
        let total_lines = lines.len()
        if total_lines == 0 {
            return DataFrame.create([], {})
        }
        let header_line = lines[0]
        let col_names = header_line.split(",")
        let num_cols = col_names.len()

        let cols_dict = {}
        let c = 0
        while c < num_cols {
            let cn = col_names[c]
            cols_dict[cn] = []
            c = c + 1
        }

        let r = 1
        while r < total_lines {
            let line = lines[r]
            if line.len() > 0 {
                let cells = line.split(",")
                if cells.len() == num_cols {
                    let col_idx = 0
                    while col_idx < num_cols {
                        let cname = col_names[col_idx]
                        let raw_val = cells[col_idx]
                        let num_val = gpu_dispatch(65.0, [raw_val])
                        let col_arr = cols_dict[cname]
                        col_arr = col_arr.push(num_val)
                        cols_dict[cname] = col_arr
                        col_idx = col_idx + 1
                    }
                }
            }
            r = r + 1
        }
        return DataFrame.create(col_names, cols_dict)
    }

    fn to_tensor(df, selected_cols) {
        let num_rows = df["num_rows"]
        let num_cols = selected_cols.len()
        let cols = df["columns"]
        let flat_arr = []
        let r = 0
        while r < num_rows {
            let c = 0
            while c < num_cols {
                let cname = selected_cols[c]
                let col_data = cols[cname]
                let val_item = col_data[r]
                flat_arr = flat_arr.push(val_item)
                c = c + 1
            }
            r = r + 1
        }
        return NDArray.from_array([num_rows, num_cols], flat_arr)
    }

    fn concat(df1, df2) {
        let col_names = df1["col_names"]
        let num_cols = col_names.len()
        let cols1 = df1["columns"]
        let cols2 = df2["columns"]
        let n1 = df1["num_rows"]
        let n2 = df2["num_rows"]
        let new_dict = {}
        let c = 0
        while c < num_cols {
            let cn = col_names[c]
            let t_arr = []
            let a1 = cols1[cn]
            let r1 = 0
            while r1 < n1 {
                let v1 = a1[r1]
                t_arr = t_arr.push(v1)
                r1 = r1 + 1
            }
            let a2 = cols2[cn]
            let r2 = 0
            while r2 < n2 {
                let v2 = a2[r2]
                t_arr = t_arr.push(v2)
                r2 = r2 + 1
            }
            new_dict[cn] = t_arr
            c = c + 1
        }
        return DataFrame.create(col_names, new_dict)
    }
}

class pd {
    fn dataframe(col_names, columns_dict) {
        return DataFrame.create(col_names, columns_dict)
    }

    fn series(name, data_array) {
        return Series.create(name, data_array)
    }

    fn read_csv(filepath) {
        return DataFrame.read_csv(filepath)
    }

    fn to_csv(df, filepath) {
        return DataFrame.to_csv(df, filepath)
    }

    fn concat(df1, df2) {
        return DataFrame.concat(df1, df2)
    }
}


fn test_numpy() {
    System.print_str("[1] Testing NumPy Creation & Linear Algebra...")
    let eye4 = np.eye(4)
    let ones4 = np.ones([4, 4])
    let mm = np.matmul(eye4, ones4)
    let s = np.sum(mm)
    let m = np.mean(mm)
    System.print_str("    np.eye(4) @ np.ones(4): sum = " + to_string(s) + " (expected 16.0), mean = " + to_string(m) + " (expected 1.0)")

    let lin = np.linspace(0.0, 10.0, 5.0)
    let lin_first = NDArray.get(lin, 0, 0)
    let lin_last = NDArray.get(lin, 0, 4)
    System.print_str("    np.linspace(0, 10, 5): first = " + to_string(lin_first) + ", last = " + to_string(lin_last) + " (expected 0.0, 10.0)")

    let clipped = np.clip(lin, 2.5, 7.5)
    let c_first = NDArray.get(clipped, 0, 0)
    let c_last = NDArray.get(clipped, 0, 4)
    System.print_str("    np.clip(lin, 2.5, 7.5): first = " + to_string(c_first) + " (expected 2.5), last = " + to_string(c_last) + " (expected 7.5)")

    NDArray.free(eye4)
    NDArray.free(ones4)
    NDArray.free(mm)
    NDArray.free(lin)
    NDArray.free(clipped)
}

fn test_series() {
    System.print_str("[2] Testing Pandas Series Operations...")
    let salaries = pd.series("salary", [45000.0, 60000.0, 80000.0, 120000.0])
    let sal_len = Series.size(salaries)
    let sal_sum = Series.sum(salaries)
    let sal_mean = Series.mean(salaries)
    let sal_min = Series.min(salaries)
    let sal_max = Series.max(salaries)
    System.print_str("    Series 'salary': len=" + to_string(sal_len) + ", sum=" + to_string(sal_sum) + ", mean=" + to_string(sal_mean) + ", min=" + to_string(sal_min) + ", max=" + to_string(sal_max))

    let sal_tensor = Series.to_tensor(salaries)
    let sal_t_sh = NDArray.shape(sal_tensor)
    System.print_str("    Series to_tensor shape: [" + to_string(sal_t_sh[0]) + ", " + to_string(sal_t_sh[1]) + "]")
    NDArray.free(sal_tensor)
}

fn test_dataframe() {
    System.print_str("[3] Testing Pandas DataFrame Creation & Manipulation...")
    let d = {
        "age": [25.0, 32.0, 45.0, 29.0],
        "experience": [2.0, 8.0, 20.0, 5.0],
        "salary": [50000.0, 75000.0, 130000.0, 68000.0]
    }
    let df = pd.dataframe(["age", "experience", "salary"], d)
    let df_sh = DataFrame.shape(df)
    System.print_str("    DataFrame shape: [" + to_string(df_sh[0]) + ", " + to_string(df_sh[1]) + "]")
    DataFrame.head(df, 4)
    DataFrame.describe(df)
}

fn test_filter() {
    System.print_str("[4] Testing Pandas DataFrame Filtering (salary > 60000)...")
    let d = {
        "age": [25.0, 32.0, 45.0, 29.0],
        "experience": [2.0, 8.0, 20.0, 5.0],
        "salary": [50000.0, 75000.0, 130000.0, 68000.0]
    }
    let df = pd.dataframe(["age", "experience", "salary"], d)
    let filtered_df = DataFrame.filter(df, "salary", ">", 60000.0)
    let f_sh = DataFrame.shape(filtered_df)
    System.print_str("    Filtered DataFrame shape: [" + to_string(f_sh[0]) + ", " + to_string(f_sh[1]) + "] (expected 3 rows)")
    DataFrame.head(filtered_df, 3)
}

fn test_csv() {
    System.print_str("[5] Testing Native CSV Export and C-Speed Parsing...")
    let d = {
        "age": [25.0, 32.0, 45.0, 29.0],
        "experience": [2.0, 8.0, 20.0, 5.0],
        "salary": [50000.0, 75000.0, 130000.0, 68000.0]
    }
    let df = pd.dataframe(["age", "experience", "salary"], d)
    let csv_path = "scratch/test_employees.csv"
    pd.to_csv(df, csv_path)
    System.print_str("    Successfully written DataFrame to " + csv_path)

    let loaded_df = pd.read_csv(csv_path)
    let loaded_sh = DataFrame.shape(loaded_df)
    System.print_str("    Successfully re-loaded DataFrame from CSV! Shape: [" + to_string(loaded_sh[0]) + ", " + to_string(loaded_sh[1]) + "]")
    DataFrame.head(loaded_df, 2)
}

fn test_tensor_conversion() {
    System.print_str("[6] Testing Direct DataFrame -> GPU Tensor Conversion...")
    let d = {
        "age": [25.0, 32.0, 45.0, 29.0],
        "experience": [2.0, 8.0, 20.0, 5.0],
        "salary": [50000.0, 75000.0, 130000.0, 68000.0]
    }
    let df = pd.dataframe(["age", "experience", "salary"], d)
    let features_tensor = DataFrame.to_tensor(df, ["age", "experience"])
    let ft_sh = NDArray.shape(features_tensor)
    System.print_str("    Extracted Features Tensor Shape: [" + to_string(ft_sh[0]) + ", " + to_string(ft_sh[1]) + "]")
    let ft_00 = NDArray.get(features_tensor, 0, 0)
    let ft_01 = NDArray.get(features_tensor, 0, 1)
    System.print_str("    Features row 0: age=" + to_string(ft_00) + ", experience=" + to_string(ft_01))
    NDArray.free(features_tensor)
}

fn test_concat() {
    System.print_str("[7] Testing DataFrame Concatenation (pd.concat)...")
    let d = {
        "age": [25.0, 32.0, 45.0, 29.0],
        "experience": [2.0, 8.0, 20.0, 5.0],
        "salary": [50000.0, 75000.0, 130000.0, 68000.0]
    }
    let df = pd.dataframe(["age", "experience", "salary"], d)
    let big_df = pd.concat(df, df)
    let big_sh = DataFrame.shape(big_df)
    System.print_str("    Concatenated DataFrame shape: [" + to_string(big_sh[0]) + ", " + to_string(big_sh[1]) + "] (expected 8 rows)")
}


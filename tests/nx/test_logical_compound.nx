# Testing logical operators and compound assignments

let a = 1
let b = 0

# Logical AND (&& and 'and')
if a && 1 {
    print(1)
} else {
    print(0)
}

if a && b {
    print(0)
} else {
    print(2)
}

if a and 1 {
    print(3)
} else {
    print(0)
}

# Logical OR (|| and 'or')
if a || b {
    print(4)
} else {
    print(0)
}

if b || 0 {
    print(0)
} else {
    print(5)
}

if b or a {
    print(6)
} else {
    print(0)
}

# Unary NOT (! and 'not')
if !b {
    print(7)
} else {
    print(0)
}

if !a {
    print(0)
} else {
    print(8)
}

if not b {
    print(9)
} else {
    print(0)
}

# Compound assignments
let x = 10
x += 5
if x == 15 {
    print(10)
} else {
    print(0)
}

x -= 3
if x == 12 {
    print(11)
} else {
    print(0)
}

x *= 2
if x == 24 {
    print(12)
} else {
    print(0)
}

x /= 4
if x == 6 {
    print(13)
} else {
    print(0)
}

# Loop with += compound assignment
let sum = 0
let i = 0
while i < 10 {
    sum += i
    i += 1
}
if sum == 45 {
    print(14)
} else {
    print(0)
}

import stdlib

fn main() {
    System.print_str("==================================================")
    System.print_str("Nexus Baremetal - Pure Native GPU Subsystem Test")
    System.print_str("==================================================")

    // 1. Initialize GPU
    let ok = GPU.init()
    if ok == 1.0 {
        System.print_str("PASS: GPU Driver Initialized Successfully")
    } else {
        System.print_str("INFO: GPU Driver initialized in Fallback mode")
    }

    // 2. Query Device Info
    let dev_name = GPU.name()
    System.print_str("Device Name: " + dev_name)

    let vram = GPU.total_memory()
    System.print_str("Total VRAM: " + to_string(vram) + " MB")

    let has_hw = GPU.is_available()
    if has_hw == 1.0 {
        System.print_str("Hardware Mode: ACTIVE (Direct NVIDIA CUDA execution)")
    } else {
        System.print_str("Hardware Mode: CPU SIMD AVX2 Fallback")
    }

    // 3. Buffer Allocation & Memory Safety
    let buf = GPU.alloc(1024)
    if buf > 0.0 {
        System.print_str("PASS: GPU.alloc allocated handle: " + to_string(buf))
    } else {
        System.print_str("FAIL: GPU.alloc")
    }

    let freed = GPU.free(buf)
    if freed == 1.0 {
        System.print_str("PASS: GPU.free released buffer safely")
    } else {
        System.print_str("FAIL: GPU.free")
    }

    // 4. Tensor Creation
    let t_a = GPU.tensor([2, 2], 3.0)
    let t_b = GPU.tensor([2, 2], 4.0)
    System.print_str("PASS: GPU tensors created (2x2 matrices)")

    // 5. Vector Addition: [3.0] + [4.0] = [7.0]
    let t_add = GPU.add(t_a, t_b)
    let arr_add = GPU.to_array(t_add)
    System.print_str("Vector Add Result element 0: " + to_string(arr_add[0]))
    if arr_add[0] == 7.0 {
        System.print_str("PASS: GPU.add hardware execution verified (3.0 + 4.0 = 7.0)")
    } else {
        System.print_str("FAIL: GPU.add")
    }

    // 6. Vector Multiplication: [3.0] * [4.0] = [12.0]
    let t_mul = GPU.mul(t_a, t_b)
    let arr_mul = GPU.to_array(t_mul)
    System.print_str("Vector Mul Result element 0: " + to_string(arr_mul[0]))
    if arr_mul[0] == 12.0 {
        System.print_str("PASS: GPU.mul hardware execution verified (3.0 * 4.0 = 12.0)")
    } else {
        System.print_str("FAIL: GPU.mul")
    }

    // 7. High-Performance Matrix Multiplication (GEMM)
    // A: 2x2 of all 2.0, B: 2x2 of all 3.0 -> C: 2x2 of all (2*3 + 2*3) = 12.0
    let mat_a = GPU.tensor([2, 2], 2.0)
    let mat_b = GPU.tensor([2, 2], 3.0)
    let mat_c = GPU.matmul(mat_a, mat_b)
    let arr_c = GPU.to_array(mat_c)
    System.print_str("GEMM Result element 0: " + to_string(arr_c[0]))
    if arr_c[0] == 12.0 {
        System.print_str("PASS: GPU.matmul Tiled GEMM verified (C[0,0] = 12.0)")
    } else {
        System.print_str("FAIL: GPU.matmul")
    }

    // 8. Neural Network ReLU Activation
    let t_relu = GPU.relu(mat_c)
    let arr_relu = GPU.to_array(t_relu)
    if arr_relu[0] == 12.0 {
        System.print_str("PASS: GPU.relu activation verified")
    } else {
        System.print_str("FAIL: GPU.relu")
    }

    // 9. Hardware Benchmarking Timer
    let t_start = GPU.time_ms()
    GPU.sync()
    let t_end = GPU.time_ms()
    let elapsed = t_end - t_start
    System.print_str("GPU Sync Latency: " + to_string(elapsed) + " ms")

    System.print_str("==================================================")
    System.print_str("All Pure Baremetal GPU Tests PASSED with Zero Errors!")
    System.print_str("==================================================")
}

main()
